---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AmbientGlow from '../../components/AmbientGlow.astro';
import SectionNav from '../../components/SectionNav.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import PostDateMeta from '../../components/PostDateMeta.astro';
import { slugify } from '../../utils/slugify';
import { tagHref, isHardLinkedTag } from '../../utils/tagHref';
import { getReadingTime } from '../../utils/readingTime';
import { hasVideoEmbed } from '../../utils/postVideo';
import { getTagTaxonomy, computeTagCacheKey } from '../../utils/tagTaxonomy';
import { getLogAnchorPageMap, getGalleryPhotoHref } from '../../utils/logTimeline';
import { getPaginatedHref } from '../../utils/pagination';
import TagList from '../../components/TagList.astro';
import { Image } from 'astro:assets';
import { siteConfig } from '../../site.config';
import { loadPhotoImage } from '../../utils/photoImages';
import { isFeatureEnabled, isUrlEnabled } from '../../utils/features';

export async function getStaticPaths() {
  if (!isFeatureEnabled('tags')) {
    return [];
  }
  const { archiveMap } = await getTagTaxonomy();
  return Array.from(archiveMap.entries())
    .filter(([slug]) => !(isHardLinkedTag(slug) && isUrlEnabled(tagHref(slug))))
    .map(([slug, data]) => ({
      params: { tag: slug },
      props: data,
      cacheKey: computeTagCacheKey(slug, data),
    }));
}

const showLog = isFeatureEnabled('log');
function resolveTagHref(slug: string): string {
  const candidate = tagHref(slug);
  return isUrlEnabled(candidate) ? candidate : `/tags/${slug.toLowerCase()}/`;
}

const { posts, logs, photoLogs = [], experiences: expMatches, tagName } = Astro.props;
const totalCount = posts.length + logs.length + expMatches.length + photoLogs.length;
const logAnchorPages = await getLogAnchorPageMap();

const resolvedPhotoLogs = await Promise.all(
  photoLogs.map(async (photo) => {
    const imageMetadata = await loadPhotoImage(photo.imageKey);
    return {
      ...photo,
      imageMetadata,
    };
  })
);

const isExperienceTag = expMatches.length > 0;
const pageTitle = isExperienceTag
  ? `${siteConfig.site.title} - ${tagName} (Career Experience)`
  : `${siteConfig.site.title} - ${tagName}`;

let description: string;
if (isExperienceTag) {
  const roleText = `${expMatches.length} ${expMatches.length === 1 ? 'role' : 'roles'}`;
  description = `Career experience (${roleText}) and background on ${tagName} by ${siteConfig.author.name}.`;
} else if (photoLogs.length > 0 && posts.length === 0 && logs.length === 0) {
  description = `Photography roll and photo rolls tagged with #${tagName} by ${siteConfig.author.name}.`;
} else {
  description = `Technical write-ups, engineering notes, and photo rolls on ${tagName} by ${siteConfig.author.name}.`;
}

const breakdownParts = [];
if (expMatches.length > 0) breakdownParts.push(`${expMatches.length} ${expMatches.length === 1 ? 'career role' : 'career roles'}`);
if (posts.length > 0) breakdownParts.push(`${posts.length} ${posts.length === 1 ? 'article' : 'articles'}`);
if (logs.length > 0) breakdownParts.push(`${logs.length} ${logs.length === 1 ? 'log update' : 'log updates'}`);
if (photoLogs.length > 0) breakdownParts.push(`${photoLogs.length} ${photoLogs.length === 1 ? 'photo' : 'photo rolls'}`);
const breakdownText = breakdownParts.join(' • ');
---

<BaseLayout
  pageTitle={pageTitle}
  description={description}
  image={`/og/tags/${slugify(tagName)}.jpg`}
  section={tagName}
  tags={[tagName]}
  breadcrumbs={[{ name: "Tags", href: "/tags/" }, { name: `#${tagName}` }]}
>
  <SectionNav slot="breadcrumb-extra" />

  <div class="relative isolate overflow-hidden py-24 sm:py-32 transition-colors">
    <AmbientGlow preset="tag-detail" />

    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <!-- Header -->
      <div class="mx-auto max-w-3xl mb-12 sm:mb-16">
        <div class="inline-flex items-center gap-2 rounded-full bg-amber-50 dark:bg-gray-800 px-3 py-1 text-xs font-semibold text-amber-700 dark:text-amber-500 ring-1 ring-inset ring-amber-600/20 dark:ring-amber-500/30 mb-3">
          <span>Topic collection</span>
        </div>
        <h1 class="text-4xl font-semibold tracking-tight text-pretty text-gray-900 dark:text-white sm:text-5xl">
          #{tagName}
        </h1>
        <p class="mt-3 text-base text-gray-600 dark:text-gray-400">
          {totalCount} {totalCount === 1 ? 'item' : 'items'} found {breakdownText && `(${breakdownText})`}
        </p>
      </div>

      <div class="mx-auto max-w-3xl space-y-16">
        
        <!-- Career Experience Section -->
        {expMatches.length > 0 && (
          <section class="space-y-6">
            <div class="flex items-center gap-2 pb-3 border-b border-gray-200 dark:border-gray-800">
              <span class="size-2 rounded-full bg-amber-600 dark:bg-amber-500"></span>
              <h2 class="text-xl font-bold tracking-tight text-gray-900 dark:text-white">
                Career Experience ({expMatches.length})
              </h2>
            </div>

            <div class="space-y-4">
              {expMatches.map((exp) => (
                <article class="relative rounded-2xl p-6 shadow-md ring-1 ring-gray-900/5 dark:ring-white/10 bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm transition-colors">
                  <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 pb-3 border-b border-gray-100 dark:border-gray-700/60">
                    <div>
                      <h3 class="text-lg font-bold text-gray-900 dark:text-white">
                        <a href="/about/#experience" class="hover:text-amber-600 dark:hover:text-amber-400 transition">
                          {exp.role}
                        </a>
                      </h3>
                      <p class="text-sm font-semibold text-amber-700 dark:text-amber-400">
                        {exp.company} <span class="text-gray-500 dark:text-gray-400 font-normal">• {exp.location}</span>
                      </p>
                    </div>
                    <span class="text-xs font-semibold text-gray-500 dark:text-gray-400">
                      {exp.period}
                    </span>
                  </div>

                  <ul class="mt-3 space-y-1.5 text-xs/5 text-gray-600 dark:text-gray-300">
                    {exp.highlights.slice(0, 2).map((h) => (
                      <li class="flex items-start gap-2">
                        <span class="size-1 rounded-full bg-amber-500 mt-1.5 shrink-0"></span>
                        <span>{h}</span>
                      </li>
                    ))}
                  </ul>

                  <div class="mt-4 flex flex-wrap gap-1.5">
                    {exp.skills.map((skill) => {
                      const isMatch = skill.toLowerCase() === tagName.toLowerCase();
                      return (
                        <a
                          href={resolveTagHref(slugify(skill))}
                          class={`relative z-10 text-[11px] font-mono px-2 py-0.5 rounded transition ${
                            isMatch
                              ? 'bg-amber-100 dark:bg-gray-700/60 text-amber-800 dark:text-amber-500 font-semibold ring-1 ring-amber-600/30 dark:ring-amber-500/30'
                              : 'bg-gray-100 dark:bg-gray-700/50 text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white'
                          }`}
                        >
                          #{skill}
                        </a>
                      );
                    })}
                  </div>
                </article>
              ))}
            </div>
          </section>
        )}

        <!-- Blog Articles Section -->
        {posts.length > 0 && (
          <section class="space-y-6">
            <div class="flex items-center gap-2 pb-3 border-b border-gray-200 dark:border-gray-800">
              <span class="size-2 rounded-full bg-amber-600 dark:bg-amber-500"></span>
              <h2 class="text-xl font-bold tracking-tight text-gray-900 dark:text-white">
                Articles ({posts.length})
              </h2>
            </div>

            <div class="space-y-6">
              {posts.map((post) => {
                const postHasVideo = hasVideoEmbed(post.body);
                return (
                <article class="border-beam-card group relative rounded-2xl p-6 sm:p-7 shadow-md hover:shadow-xl ring-1 ring-gray-900/5 dark:ring-white/10 bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm transition-all duration-200">
                  <div class="flex items-center justify-between text-xs text-gray-500 dark:text-gray-400 mb-2">
                    <PostDateMeta
                      pubDate={post.data.pubDate}
                      updatedDate={post.data.updatedDate}
                    />
                    <div class="flex shrink-0 items-center gap-2.5">
                      {postHasVideo && (
                        <a
                          href={`/blog/${post.id}/#video`}
                          class="relative z-10 inline-flex items-center gap-1 rounded-full bg-amber-50 dark:bg-gray-700/60 px-2.5 py-0.5 text-[11px]/4 font-semibold text-amber-700 dark:text-amber-500 ring-1 ring-inset ring-amber-600/30 dark:ring-amber-500/30 hover:bg-amber-500 hover:text-gray-950 dark:hover:bg-amber-500 dark:hover:text-gray-950 transition-colors"
                          aria-label={`Watch video in: ${post.data.title}`}
                          title="Jump straight to the video in this article"
                        >
                          <svg class="size-3 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                            <path d="M6.3 2.84A1.5 1.5 0 0 0 4 4.11v11.78a1.5 1.5 0 0 0 2.3 1.27l9.344-5.891a1.5 1.5 0 0 0 0-2.538L6.3 2.841Z" />
                          </svg>
                          <span>Watch</span>
                        </a>
                      )}
                      <span class="inline-flex items-center gap-1 font-mono text-amber-700 dark:text-amber-400">
                        <svg class="size-3.5 shrink-0" aria-hidden="true"><use href="#i-clock" /></svg>
                        {getReadingTime(post.body)}
                      </span>
                    </div>
                  </div>

                  <h3 class="text-lg font-semibold text-gray-900 dark:text-white group-hover:text-amber-600 dark:group-hover:text-amber-400 transition">
                    <a href={`/blog/${post.id}/`}>
                      <span class="absolute inset-0"></span>
                      {post.data.title}
                    </a>
                  </h3>

                  <p class="mt-2 text-sm/6 text-gray-600 dark:text-gray-300 line-clamp-2">
                    {post.data.description}
                  </p>

                  {post.data.tags && post.data.tags.length > 0 && (
                    <div class="mt-4 flex flex-wrap gap-1.5">
                      {post.data.tags.map((t: string) => {
                        const isMatch = t.toLowerCase() === tagName.toLowerCase();
                        return (
                          <a
                            href={resolveTagHref(slugify(t))}
                            class={`relative z-10 text-[11px] font-mono px-2 py-0.5 rounded transition ${
                              isMatch
                                ? 'bg-amber-100 dark:bg-gray-700/60 text-amber-800 dark:text-amber-500 font-semibold ring-1 ring-amber-600/30 dark:ring-amber-500/30'
                                : 'bg-gray-100 dark:bg-gray-700/50 text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white'
                            }`}
                          >
                            #{t}
                          </a>
                        );
                      })}
                    </div>
                  )}
                </article>
                );
              })}
            </div>
          </section>
        )}

        <!-- Log Updates Section -->
        {logs.length > 0 && (
          <section class="space-y-6">
            <div class="flex items-center gap-2 pb-3 border-b border-gray-200 dark:border-gray-800">
              <span class="size-2 rounded-full bg-amber-600 dark:bg-amber-500"></span>
              <h2 class="text-xl font-bold tracking-tight text-gray-900 dark:text-white">
                Log Updates ({logs.length})
              </h2>
            </div>

            <div class="space-y-4">
              {logs.map((log) => {
                const anchorId = log.id;
                return (
                  <article class="border-beam-card group relative rounded-2xl p-6 shadow-md hover:shadow-xl ring-1 ring-gray-900/5 dark:ring-white/10 bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm transition-all duration-200">
                    <div class="flex items-center justify-between text-xs text-amber-700 dark:text-amber-400 mb-2 font-mono">
                      <FormattedDate date={log.date} />
                      <span class="text-gray-500 dark:text-gray-400 group-hover:text-amber-600 transition">View in Log &rarr;</span>
                    </div>

                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white group-hover:text-amber-600 dark:group-hover:text-amber-400 transition">
                      <a href={getPaginatedHref('/log', logAnchorPages[anchorId] ?? 1, `#${anchorId}`)}>
                        <span class="absolute inset-0"></span>
                        {log.title}
                      </a>
                    </h3>

                    {log.tags && log.tags.length > 0 && (
                      <div class="mt-4 flex flex-wrap gap-1.5">
                        {log.tags.map((t: string) => {
                          const isMatch = t.toLowerCase() === tagName.toLowerCase();
                          return (
                            <a
                              href={resolveTagHref(slugify(t))}
                              class={`relative z-10 text-[11px] font-mono px-2 py-0.5 rounded transition ${
                                isMatch
                                  ? 'bg-amber-100 dark:bg-gray-700/60 text-amber-800 dark:text-amber-500 font-semibold ring-1 ring-amber-600/30 dark:ring-amber-500/30'
                                  : 'bg-gray-100 dark:bg-gray-700/50 text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white'
                              }`}
                            >
                              #{t}
                            </a>
                          );
                        })}
                      </div>
                    )}
                  </article>
                );
              })}
            </div>
          </section>
        )}

        <!-- Photo Rolls Section -->
        {resolvedPhotoLogs.length > 0 && (
          <section class="space-y-6">
            <div class="flex items-center gap-2 pb-3 border-b border-gray-200 dark:border-gray-800">
              <span class="size-2 rounded-full bg-amber-600 dark:bg-amber-500"></span>
              <h2 class="text-xl font-bold tracking-tight text-gray-900 dark:text-white flex items-center gap-2">
                <span>Photo Rolls</span>
                <span class="text-sm font-normal text-gray-500 dark:text-gray-400">({resolvedPhotoLogs.length})</span>
              </h2>
            </div>

            <div class="space-y-8">
              {resolvedPhotoLogs.map((photo) => (
                <article class="space-y-3">
                  <!-- Date & Tags above card -->
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 text-xs">
                    <FormattedDate date={photo.pubDate} />
                    <span class="inline-flex items-center gap-1 font-semibold text-amber-700 dark:text-amber-500 bg-amber-50 dark:bg-gray-800 px-2 py-0.5 rounded-md ring-1 ring-inset ring-amber-600/30 dark:ring-amber-500/30 text-[11px]">
                      <svg class="size-3" aria-hidden="true"><use href="#i-camera" /></svg>
                      <span>Photo • {photo.category}</span>
                    </span>
                    <span class="text-gray-400 dark:text-gray-500" aria-hidden="true">•</span>
                    <span class="inline-flex items-center gap-1 text-gray-500 dark:text-gray-400 font-medium">
                      <svg class="size-3.5 text-amber-600 dark:text-amber-500 shrink-0" aria-hidden="true"><use href="#i-pin" /></svg>
                      <span>{photo.location}</span>
                    </span>
                    {photo.attribution && (
                      <>
                        <span class="text-gray-400 dark:text-gray-500" aria-hidden="true">•</span>
                        <span class="text-gray-500 dark:text-gray-400 font-mono text-[11px]">{photo.attribution}</span>
                      </>
                    )}
                    {photo.tags && photo.tags.length > 0 && (
                      <TagList tags={photo.tags} />
                    )}
                  </div>

                  <!-- Photo Roll Card (Clickable to Gallery Lightbox) -->
                  <a
                    href={getGalleryPhotoHref(photo.id)}
                    aria-label={`View ${photo.title} in photo gallery`}
                    class="border-beam-card group/card block rounded-2xl p-6 sm:p-7 shadow-md hover:shadow-xl ring-1 ring-gray-900/5 bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm dark:ring-white/10 hover:ring-amber-500/40 transition-all duration-200 cursor-pointer no-underline"
                  >
                    <div class="grid grid-cols-1 sm:grid-cols-12 gap-6 items-start">
                      <!-- Image Thumbnail Column -->
                      <div class="sm:col-span-5 relative overflow-hidden rounded-xl bg-gray-100 dark:bg-gray-900 ring-1 ring-gray-900/10 dark:ring-white/10 shadow-sm aspect-[4/3] w-full">
                        {photo.imageMetadata && (
                          <Image
                            src={photo.imageMetadata}
                            alt={photo.title}
                            widths={[320, 480, 640]}
                            sizes="(min-width: 640px) 320px, 90vw"
                            quality={72}
                            loading="lazy"
                            class="w-full h-full object-cover transition-transform duration-300 group-hover/card:scale-105"
                          />
                        )}
                      </div>

                      <!-- Content Column -->
                      <div class="sm:col-span-7 flex flex-col justify-between space-y-3">
                        <div>
                          <div class="pb-2 border-b border-gray-100 dark:border-gray-700/60">
                            <h3 class="text-xl font-semibold tracking-tight text-gray-900 dark:text-white group-hover/card:text-amber-600 dark:group-hover/card:text-amber-400 transition-colors">
                              {photo.title}
                            </h3>
                          </div>

                          <p class="text-sm/6 text-gray-600 dark:text-gray-300 mt-3">
                            {photo.story}
                          </p>
                        </div>
                      </div>
                    </div>
                  </a>
                </article>
              ))}
            </div>
          </section>
        )}

        <!-- Back to all tags -->
        <div class="pt-6 border-t border-gray-200 dark:border-gray-800 flex justify-between items-center text-sm">
          <a href="/tags/" class="text-amber-700 dark:text-amber-400 font-semibold hover:underline">
            &larr; View all tags
          </a>
          {showLog && (
            <a href="/log/" class="text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition">
              View full stream &rarr;
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
