---
import BaseLayout from '../layouts/BaseLayout.astro';
import AmbientGlow from '../components/AmbientGlow.astro';
import { siteConfig } from '../site.config';
import { getEffectiveHomePage, isFeatureEnabled } from '../utils/features';

const pageTitle = `${siteConfig.site.title} - Page Not Found`;
const description = `Page not found — The requested page could not be located on ${siteConfig.site.domain}.`;
const showBrowseBlog = isFeatureEnabled('blog') && getEffectiveHomePage() !== 'blog';
---

<BaseLayout pageTitle={pageTitle} description={description} image="/og/default.jpg" noindex={true}>
  <section class="relative isolate flex min-h-[70vh] items-center justify-center overflow-hidden px-6 py-24 sm:py-32 lg:px-8">
    <AmbientGlow preset="404" />

    <div class="mx-auto w-full max-w-xl rounded-2xl bg-white/85 dark:bg-gray-800/85 p-8 sm:p-12 text-center shadow-lg ring-1 ring-gray-900/5 dark:ring-white/10 backdrop-blur-sm">
      <span class="inline-flex items-center gap-2 rounded-full bg-amber-50 dark:bg-gray-800 px-3 py-1 text-xs font-mono font-semibold text-amber-700 dark:text-amber-500 ring-1 ring-inset ring-amber-600/25 dark:ring-amber-500/30">
        <span class="size-1.5 rounded-full bg-amber-600 dark:bg-amber-400" aria-hidden="true"></span>
        <span>HTTP 404</span>
      </span>

      <h1 class="mt-5 text-4xl font-semibold tracking-tight text-balance text-gray-900 dark:text-white sm:text-5xl">
        Page not found
      </h1>

      <p class="mt-4 text-base/7 text-gray-600 dark:text-gray-300">
        Sorry, the page or resource you requested doesn’t exist or may have moved.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/"
          class="inline-flex items-center justify-center rounded-lg bg-amber-700 px-4 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-amber-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600 transition-colors"
        >
          Go back home
        </a>
        {showBrowseBlog && (
          <a
            href="/blog/"
            class="inline-flex items-center gap-1.5 rounded-lg px-4 py-2.5 text-sm font-semibold text-gray-700 dark:text-gray-200 ring-1 ring-inset ring-gray-300 dark:ring-gray-700 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors"
          >
            <span>Browse articles</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
