---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AmbientGlow from '../AmbientGlow.astro';
import { Picture } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import { authorAboutImage as Headshot } from '../../utils/authorImages';
import { siteConfig } from '../../site.config';
import ExperienceTimeline from '../ExperienceTimeline.astro';
import { experiences } from '../../data/experiences';
import AboutFaq from '../AboutFaq.astro';
import SectionNav from '../SectionNav.astro';
import ContactForm from '../ContactForm.astro';
import { isContactFormEnabled } from '../../utils/features';
import {
  LINKEDIN_PROFILE_URL,
  featuredRecommendation,
  leftStackRecommendations,
  midLeftRecommendation,
  midRightRecommendation,
  rightStackRecommendations,
  type RecommendationItem,
} from '../../data/recommendations';

const showContactForm = isContactFormEnabled();

const aboutEntry = await getEntry('pages', 'about');
const { Content } = await render(aboutEntry!);
const aboutData = aboutEntry!.data;
const pageTitle = aboutData.pageTitle;
const description = aboutData.description;
const languages = aboutData.languages ?? [];
const interests = aboutData.interests ?? [];
const hasFaq = (aboutData.faq?.groups ?? []).some((group) => group.items.length > 0);
const interestStyles = [
  'bg-rose-50 text-rose-800 ring-rose-200 dark:bg-rose-950/50 dark:text-rose-200 dark:ring-rose-800',
  'bg-sky-50 text-sky-800 ring-sky-200 dark:bg-sky-950/50 dark:text-sky-200 dark:ring-sky-800',
  'bg-emerald-50 text-emerald-800 ring-emerald-200 dark:bg-emerald-950/50 dark:text-emerald-200 dark:ring-emerald-800',
  'bg-violet-50 text-violet-800 ring-violet-200 dark:bg-violet-950/50 dark:text-violet-200 dark:ring-violet-800',
];
const hasRecommendations = [
  featuredRecommendation,
  midLeftRecommendation,
  midRightRecommendation,
  ...leftStackRecommendations,
  ...rightStackRecommendations,
].some((rec) => rec !== null && rec.paragraphs.length > 0);
const recommendationsHeader = aboutData.recommendations ?? {
  eyebrow: 'Recommendations',
  heading: 'I have worked with amazing people',
};
const contactSection = aboutData.contactSection ?? {
  title: 'Get in touch',
  subtitle:
    'Interested in working together, discussing infrastructure, or have questions about my background? Feel free to reach out directly.',
  subject: 'Contact via About page',
};

const badgeClasses: Record<'fluent' | 'native' | 'beginner', string> = {
  fluent:
    'inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-accent-50 text-accent-700 dark:bg-gray-700/60 dark:text-accent-500 ring-1 ring-inset ring-accent-600/20 dark:ring-accent-500/30',
  native:
    'inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-accent-100 text-accent-800 dark:bg-gray-700/80 dark:text-accent-400 ring-1 ring-inset ring-accent-600/20 dark:ring-accent-500/40',
  beginner:
    'inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-700 dark:bg-gray-700/60 dark:text-gray-300 ring-1 ring-inset ring-gray-200 dark:ring-gray-700',
};

const aboutSections = [
  { id: 'overview', label: 'Overview' },
  ...(interests.length > 0 ? [{ id: 'interests', label: 'Interests' }] : []),
  ...(experiences.length > 0 ? [{ id: 'experience', label: 'Experience' }] : []),
  ...(hasRecommendations ? [{ id: 'recommendations', label: 'Recommendations' }] : []),
  ...(hasFaq ? [{ id: 'faq', label: 'FAQ' }] : []),
  ...(showContactForm ? [{ id: 'contact', label: 'Contact' }] : []),
];
---

<BaseLayout
  pageTitle={pageTitle}
  description={description}
  image="/og/about.jpg"
  imageAlt={pageTitle}
  type="profile"
>

<!-- Sub-Navigation Bar: In breadcrumbs row, pops out on scroll -->
<SectionNav sections={aboutSections} slot="breadcrumb-extra" ariaLabel="About page sections" />

<!-- intro with ambient hue background -->

<div id="overview" class="scroll-mt-16 relative isolate overflow-hidden py-12 sm:py-16">
  <AmbientGlow preset="about" />

  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="grid grid-cols-1 items-stretch gap-6 md:grid-cols-[minmax(0,1fr)_20rem]">
      <div class="min-w-0">
        <div class="flex h-full flex-col justify-center gap-5 rounded-2xl p-6 sm:p-8 shadow-lg ring-1 ring-gray-900/5 bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm dark:ring-white/10">
          <h2 class="text-3xl font-semibold tracking-tight text-gray-900 dark:text-white sm:text-4xl">{aboutData.heading}</h2>
          <p class="text-xl/8 font-medium text-gray-900 dark:text-white">{aboutData.greeting}</p>
          <div class="prose dark:prose-invert max-w-none text-base/7 text-gray-600 dark:text-gray-300">
            <Content />
          </div>
        </div>
      </div>
      <div class="flex min-w-0 flex-col gap-4">
        <div class="flex flex-1 flex-col justify-center overflow-hidden rounded-2xl bg-white/80 p-5 shadow-lg ring-1 ring-gray-900/5 backdrop-blur-sm dark:bg-gray-800/80 dark:ring-white/10">
        <div class="mx-auto w-full max-w-48">
          <Picture
            src={Headshot}
            formats={['avif', 'webp']}
            widths={[192, 384, 500]}
            sizes="192px"
            quality={90}
            alt={siteConfig.author.aboutImageAlt ?? siteConfig.author.name}
            loading="eager"
            fetchpriority="high"
            class="aspect-square w-full rounded-xl object-contain"
          />
        </div>

        {interests.length > 0 && (
          <section id="interests" aria-labelledby="about-interests-heading" class="scroll-mt-24 mt-4 w-full border-t border-gray-200/70 pt-4 dark:border-gray-700/70">
            <h3 id="about-interests-heading" class="text-lg font-semibold tracking-tight text-gray-900 dark:text-white">
              {aboutData.interestsHeading ?? 'Interests'}
            </h3>
            <ul role="list" class="mt-3 flex flex-wrap gap-2">
              {interests.map((interest, index) => (
                <li class:list={[
                  'inline-flex max-w-full items-center gap-1.5 rounded-full px-2.5 py-1.5 text-xs font-semibold ring-1 ring-inset',
                  interestStyles[index % interestStyles.length],
                ]}>
                  <span class="size-1.5 shrink-0 rounded-full bg-current opacity-60" aria-hidden="true"></span>
                  {interest}
                </li>
              ))}
            </ul>
          </section>
        )}
        </div>

        <!-- Languages Card -->
        {languages.length > 0 && (
        <div class="w-full max-w-lg rounded-2xl p-6 sm:p-7 shadow-lg ring-1 ring-gray-900/5 bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm dark:ring-white/10 transition-colors">
          <div class="flex items-center gap-2.5 pb-4 border-b border-gray-100 dark:border-gray-700/60">
            <svg class="size-5 text-accent-600 dark:text-accent-500" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="m10.5 21 5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802" />
            </svg>
            <h3 class="text-base font-semibold text-gray-900 dark:text-white">{aboutData.languagesHeading ?? 'Languages'}</h3>
          </div>
          
          <dl class="mt-4 divide-y divide-gray-100 dark:divide-gray-700/40">
            {languages.map((lang) => (
              <div class="flex items-center justify-between py-2.5">
                <dt class="text-sm font-medium text-gray-900 dark:text-gray-100 flex items-center gap-2">
                  <span>{lang.name}</span>
                  {lang.nativeName && (
                    <span class="text-xs text-gray-500 dark:text-gray-400 font-normal">{lang.nativeName}</span>
                  )}
                </dt>
                <dd>
                  <span class={badgeClasses[lang.badgeStyle]}>
                    {lang.level}
                  </span>
                </dd>
              </div>
            ))}
          </dl>
        </div>
        )}
      </div>
    </div>
  </div>
</div>

<!-- work experience timeline -->
{experiences.length > 0 && <ExperienceTimeline />}


<!-- Peer Recommendations -->
{hasRecommendations && (
<section id="recommendations" aria-labelledby="recommendations-heading" class="scroll-mt-16 relative isolate pt-24 pb-32 sm:pt-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <header class="mx-auto max-w-2xl text-center">
      <p class="text-base/7 font-semibold text-accent-700 dark:text-accent-500">{recommendationsHeader.eyebrow}</p>
      <h2 id="recommendations-heading" class="mt-2 text-4xl font-semibold tracking-tight text-balance text-gray-900 dark:text-white sm:text-5xl">
        {recommendationsHeader.heading}
      </h2>
    </header>

    <div class="mx-auto mt-16 grid max-w-2xl grid-cols-1 gap-8 text-sm/6 sm:mt-20 xl:mx-0 xl:max-w-none xl:grid-cols-12 xl:items-start">
      <!-- Left Rail (3 of 12 cols on desktop) -->
      <div class="space-y-8 xl:col-span-3 xl:order-1 order-2">
        {leftStackRecommendations.map((rec) => (
          <figure class="rounded-2xl bg-white/90 dark:bg-gray-800/90 backdrop-blur-sm p-6 shadow-lg ring-1 ring-gray-900/5 dark:ring-white/10">
            <blockquote class="text-gray-800 dark:text-gray-100 space-y-4">
              {rec.paragraphs.map((para) => (
                <p>{para}</p>
              ))}
            </blockquote>
            <figcaption class="mt-6 flex items-center gap-3.5 pt-4 border-t border-gray-100 dark:border-gray-700/60">
              <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-full bg-gray-600 dark:bg-gray-700 text-sm font-semibold text-white ring-1 ring-inset ring-black/10 dark:ring-white/15">
                {rec.initials}
              </span>
              <a
                href={LINKEDIN_PROFILE_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="text-gray-600 dark:text-gray-400 hover:text-accent-600 dark:hover:text-accent-400 transition-colors"
              >
                @ LinkedIn
              </a>
            </figcaption>
          </figure>
        ))}
      </div>

      <!-- Center Featured Column + Sub-Pair (6 of 12 cols on desktop) -->
      <div class="space-y-8 xl:col-span-6 xl:order-2 order-1">
        {featuredRecommendation && (
        <figure class="rounded-2xl bg-white/95 dark:bg-gray-800/95 backdrop-blur-sm shadow-lg ring-1 ring-gray-900/5 dark:ring-white/10">
          <blockquote class="p-6 text-lg font-semibold tracking-tight text-gray-900 dark:text-gray-100 sm:p-10 sm:text-xl/8 space-y-5">
            {featuredRecommendation.paragraphs.map((para) => (
              <p>{para}</p>
            ))}
          </blockquote>
          <figcaption class="flex items-center gap-3.5 border-t border-gray-200/80 dark:border-gray-700/70 px-6 py-4 sm:px-10">
            <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-full bg-gray-600 dark:bg-gray-700 text-sm font-semibold text-white ring-1 ring-inset ring-black/10 dark:ring-white/15">
              {featuredRecommendation.initials}
            </span>
            <a
              href={LINKEDIN_PROFILE_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-600 dark:text-gray-400 hover:text-accent-600 dark:hover:text-accent-400 transition-colors"
            >
              @ LinkedIn
            </a>
          </figcaption>
        </figure>
        )}

        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2">
          {[midLeftRecommendation, midRightRecommendation]
            .filter((rec): rec is RecommendationItem => rec !== null)
            .map((rec) => (
            <figure class="rounded-2xl bg-white/90 dark:bg-gray-800/90 backdrop-blur-sm p-6 shadow-lg ring-1 ring-gray-900/5 dark:ring-white/10 flex flex-col justify-between">
              <blockquote class="text-gray-800 dark:text-gray-100 space-y-4">
                {rec.paragraphs.map((para) => (
                  <p>{para}</p>
                ))}
              </blockquote>
              <figcaption class="mt-6 flex items-center gap-3.5 pt-4 border-t border-gray-100 dark:border-gray-700/60">
                <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-full bg-gray-600 dark:bg-gray-700 text-sm font-semibold text-white ring-1 ring-inset ring-black/10 dark:ring-white/15">
                  {rec.initials}
                </span>
                <a
                  href={LINKEDIN_PROFILE_URL}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-gray-600 dark:text-gray-400 hover:text-accent-600 dark:hover:text-accent-400 transition-colors"
                >
                  @ LinkedIn
                </a>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>

      <!-- Right Rail (3 of 12 cols on desktop) -->
      <div class="space-y-8 xl:col-span-3 xl:order-3 order-3">
        {rightStackRecommendations.map((rec) => (
          <figure class="rounded-2xl bg-white/90 dark:bg-gray-800/90 backdrop-blur-sm p-6 shadow-lg ring-1 ring-gray-900/5 dark:ring-white/10">
            <blockquote class="text-gray-800 dark:text-gray-100 space-y-4">
              {rec.paragraphs.map((para) => (
                <p>{para}</p>
              ))}
            </blockquote>
            <figcaption class="mt-6 flex items-center gap-3.5 pt-4 border-t border-gray-100 dark:border-gray-700/60">
              <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-full bg-gray-600 dark:bg-gray-700 text-sm font-semibold text-white ring-1 ring-inset ring-black/10 dark:ring-white/15">
                {rec.initials}
              </span>
              <a
                href={LINKEDIN_PROFILE_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="text-gray-600 dark:text-gray-400 hover:text-accent-600 dark:hover:text-accent-400 transition-colors"
              >
                @ LinkedIn
              </a>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </div>
</section>
)}

<!-- FAQ Section -->
{hasFaq && <AboutFaq faq={aboutData.faq} />}

{showContactForm && (
  <div id="contact" class="scroll-mt-16 py-20 sm:py-28 border-t border-gray-200/70 dark:border-gray-800">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="w-full">
        <ContactForm
          title={contactSection.title}
          subtitle={contactSection.subtitle}
          subject={contactSection.subject}
        />
      </div>
    </div>
  </div>
)}
  
</BaseLayout>
