---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AmbientGlow from '../AmbientGlow.astro';
import AsciiTagline from '../AsciiTagline.astro';
import AsciiToggle from '../AsciiToggle.astro';
import CarouselScript from '../scripts/CarouselScript.astro';
import AuthorChip from '../AuthorChip.astro';
import PostDateMeta from '../PostDateMeta.astro';
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { siteConfig } from '../../site.config';
import { themeConfig } from '../../theme.config';
import FormattedDate from '../FormattedDate.astro';
import TagList from '../TagList.astro';
import BlogCardMedia from '../BlogCardMedia.astro';
import TypingCat from '../TypingCat.astro';
import { getReadingTime } from '../../utils/readingTime';
import { getFirstVideoEmbed } from '../../utils/postVideo';
import { getFirstParagraph } from '../../utils/postExcerpt';
import { getExcerpt } from '../../utils/excerpt';
import { getChangelogEntries } from '../../utils/changelog';
import { pictureLogs, pictureLogsMap, comparePhotoPathsByDateDesc } from '../../utils/pictureLogs';
import { getGalleryPhotoHref } from '../../utils/logTimeline';
import { photoImageModules, loadPhotoImage } from '../../utils/photoImages';
import { isFeatureEnabled, isUrlEnabled } from '../../utils/features';

const showBlog = isFeatureEnabled('blog');
const showPhotos = isFeatureEnabled('photography');
const showLog = isFeatureEnabled('log');

const carouselCount = themeConfig.pagination.homepageCarouselCount;

const posts = showBlog
  ? (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  : [];

const featuredBlogPosts = showBlog
  ? await Promise.all(
      posts.slice(0, carouselCount).map(async (post) => ({
        post,
        video: await getFirstVideoEmbed(post.body),
        firstParagraph: getFirstParagraph(post.body),
      })),
    )
  : [];

const hasVideoInFeatured = featuredBlogPosts.some(({ post, video }) => Boolean(video) && !post.data.heroImage);

const rawLogEntries = showLog ? await getCollection('log') : [];
const changelogEntries = showLog ? await getChangelogEntries() : [];

interface HomeLogItem {
  id: string;
  kind: 'note' | 'changelog' | 'photo';
  date: Date;
  title: string;
  excerpt: string;
  tags: string[];
  filename?: string;
  photoId?: number;
  imageData?: ImageMetadata;
}

const rawCombinedLogEntries: HomeLogItem[] = showLog
  ? [
      ...rawLogEntries.map((e) => ({
        id: e.id.replace(/\.[^/.]+$/, ''),
        kind: 'note' as const,
        date: e.data.date,
        title: e.data.title,
        excerpt: getExcerpt(e.body ?? ''),
        tags: e.data.tags || [],
      })),
      ...changelogEntries.map((c) => ({
        id: c.id,
        kind: 'changelog' as const,
        date: c.date,
        title: c.title,
        excerpt: getExcerpt(c.rawMarkdown),
        tags: c.tags || [],
      })),
      ...(showPhotos
        ? pictureLogs.map((p) => ({
            id: `photo-${p.id}`,
            kind: 'photo' as const,
            date: p.pubDate,
            title: p.title,
            excerpt: getExcerpt(p.story),
            tags: p.tags || [],
            filename: p.filename,
            photoId: p.id,
          }))
        : []),
    ]
      .sort((a, b) => b.date.valueOf() - a.date.valueOf())
      .slice(0, carouselCount)
  : [];

const logEntries: HomeLogItem[] = await Promise.all(
  rawCombinedLogEntries.map(async (item) => {
    if (item.kind === 'photo' && item.filename) {
      const imageData = await loadPhotoImage(item.filename);
      if (imageData) return { ...item, imageData };
    }
    return item;
  }),
);

// Sort photos by publication date descending (newest first, e.g. 2026 -> 2016)
const sortedImageEntries = showPhotos
  ? Object.entries(photoImageModules).sort(([pathA], [pathB]) =>
      comparePhotoPathsByDateDesc(pathA, pathB),
    )
  : [];

const featuredPhotos = showPhotos
  ? await Promise.all(
      sortedImageEntries.slice(0, carouselCount).map(async ([path, imageImporter]) => {
        const { default: imageData } = await imageImporter();
        const filename = path.split('/').pop() ?? '';
        const photo = pictureLogsMap.get(filename);
        const altText = photo ? `${photo.title} — ${photo.location}` : 'Gallery photograph';
        return {
          imageData,
          altText,
          photo,
        };
      }),
    )
  : [];

const homeEntry = await getEntry('pages', 'home');
const homeData = homeEntry!.data;
const pageTitle = homeData.pageTitle;
const description = homeData.description;
const intro = homeData.intro!;
const setupGuide = homeData.setupGuide;
const photosSection = homeData.photosSection!;
const blogSection = homeData.blogSection!;
const logSection = homeData.logSection!;

const showIntroCta = isUrlEnabled(intro.ctaHref);
const showSetupGuide = Boolean(
  showBlog && setupGuide && setupGuide.enabled !== false && setupGuide.steps.length > 0,
);
---

<BaseLayout
  pageTitle={pageTitle}
  description={description}
  image="/og/home.jpg"
  imageAlt={siteConfig.author.name}
>

<!-- One soft glow behind the intro and the blog, so the page reads as a single surface -->
<div class="relative isolate overflow-hidden">
<AmbientGlow preset="home-top" />

<div id="intro" class="scroll-mt-16 pt-8 sm:pt-10">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl lg:mx-0 lg:max-w-none rounded-2xl px-6 py-7 sm:px-10 sm:py-8 shadow-lg ring-1 ring-gray-900/5 bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm dark:ring-white/10">
      <div data-ascii-group class="relative grid grid-cols-1 items-center gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,21rem)] xl:gap-12">
        <div>
          <h1 class="text-4xl font-semibold tracking-tight text-pretty text-gray-900 dark:text-white sm:text-5xl">{intro.heading}</h1>
          <AsciiTagline phrases={intro.taglines} class="mt-2" />
          <p class="mt-4 max-w-xl text-base/7 text-gray-700 dark:text-gray-300">
            {intro.lead}
          </p>
          {(showIntroCta || showSetupGuide) && (
            <div class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2">
              {showIntroCta && (
                <a href={intro.ctaHref} class="inline-block text-sm/6 font-semibold text-accent-700 hover:text-accent-600 dark:text-accent-500 dark:hover:text-accent-400">{intro.ctaLabel} <span aria-hidden="true">&rarr;</span></a>
              )}
              {showSetupGuide && (
                <a href="#blog" class="inline-block text-sm/6 font-semibold text-gray-700 hover:text-accent-600 dark:text-gray-300 dark:hover:text-accent-400 transition-colors">Jump to setup articles <span aria-hidden="true">&darr;</span></a>
              )}
            </div>
          )}
        </div>
        <TypingCat class="mx-auto w-full max-w-xs lg:max-w-none" />
        <AsciiToggle class="absolute bottom-0 right-0" />
      </div>

      {showSetupGuide && setupGuide && (
        <div class="mt-10 pt-10 border-t border-gray-200/80 dark:border-gray-700/70">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <div class="inline-flex items-center gap-2 rounded-full bg-accent-500/10 dark:bg-accent-500/15 px-3 py-1 text-xs font-semibold tracking-wide text-accent-800 dark:text-accent-400 ring-1 ring-inset ring-accent-500/25">
                <svg class="size-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
                </svg>
                <span>{setupGuide.eyebrow}</span>
              </div>
              <h2 class="mt-3 text-2xl font-semibold tracking-tight text-gray-900 dark:text-white sm:text-3xl">
                {setupGuide.heading}
              </h2>
              {setupGuide.subtitle && (
                <p class="mt-1.5 max-w-3xl text-sm/6 text-gray-600 dark:text-gray-300">
                  {setupGuide.subtitle}
                </p>
              )}
            </div>
            <a
              href="/blog/"
              class="shrink-0 inline-flex items-center gap-1.5 text-sm font-semibold text-accent-700 hover:text-accent-600 dark:text-accent-500 dark:hover:text-accent-400"
            >
              <span>All setup & blog articles</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>

          <div class="mt-6 grid grid-cols-1 gap-5 lg:grid-cols-3">
            {setupGuide.steps.map((item) => (
              <div class="border-beam-card group relative flex flex-col justify-between rounded-xl bg-gray-50/90 dark:bg-gray-900/75 p-5 sm:p-6 shadow-md ring-1 ring-accent-500/25 dark:ring-accent-500/30 transition hover:shadow-lg hover:ring-accent-500/50">
                <div>
                  <div class="flex items-center justify-between gap-2">
                    <span class="inline-flex items-center rounded-md bg-accent-500 px-2.5 py-0.5 text-xs font-bold uppercase tracking-wider text-gray-950 shadow-2xs">
                      {item.step}
                    </span>
                    {item.badge && (
                      <span class="inline-flex items-center rounded-md bg-gray-200/80 dark:bg-gray-800 px-2 py-0.5 text-[11px] font-medium text-gray-700 dark:text-accent-400 ring-1 ring-inset ring-gray-300/80 dark:ring-accent-500/25">
                        {item.badge}
                      </span>
                    )}
                  </div>
                  <h3 class="mt-3.5 text-base/6 font-semibold text-gray-900 dark:text-white group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors">
                    <a href={item.href}>
                      <span class="absolute inset-0"></span>
                      {item.title}
                    </a>
                  </h3>
                  <p class="mt-2.5 text-xs/5 sm:text-sm/6 text-gray-600 dark:text-gray-300">
                    {item.description}
                  </p>
                </div>
                <div class="mt-4 pt-3 border-t border-gray-200/70 dark:border-gray-800 flex items-center justify-between text-xs font-semibold text-accent-700 dark:text-accent-500 group-hover:text-accent-600 dark:group-hover:text-accent-400">
                  <span>{item.ctaLabel ?? 'Read guide'}</span>
                  <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">&rarr;</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</div>

{showBlog && (
  <section id="blog" aria-labelledby="home-blog-heading" class="scroll-mt-16 relative pt-12 pb-20 sm:pt-14 sm:pb-24" data-carousel-container="blog">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <header class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-2xl">
          <h2 id="home-blog-heading" class="text-4xl font-semibold tracking-tight text-pretty text-gray-900 dark:text-white sm:text-5xl">
            {blogSection.heading}
          </h2>
          <p class="mt-2 text-lg/8 text-gray-600 dark:text-gray-400">
            {blogSection.subtitle}{' '}
            <a href="/blog/" class="text-sm/6 font-semibold text-accent-700 hover:text-accent-600 dark:text-accent-500 dark:hover:text-accent-400">
              {blogSection.linkLabel} <span aria-hidden="true">&rarr;</span>
            </a>
          </p>
        </div>

        <div class="flex items-center gap-3 shrink-0 self-start sm:self-end">
          <span class="carousel-counter text-xs font-medium text-gray-600 dark:text-gray-300 bg-gray-100 dark:bg-gray-800/80 px-2.5 py-1 rounded-full ring-1 ring-inset ring-gray-200 dark:ring-gray-700">
            1–3 of {featuredBlogPosts.length}
          </span>
          <div class="flex items-center gap-1.5">
            <button
              type="button"
              class="carousel-prev size-9.5 inline-flex items-center justify-center rounded-full border border-gray-200/80 dark:border-gray-800 bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm text-gray-700 dark:text-gray-300 shadow-xs hover:border-accent-500 hover:text-accent-500 dark:hover:border-accent-500 dark:hover:text-accent-400 transition-colors disabled:opacity-35 disabled:cursor-not-allowed cursor-pointer"
              aria-label="Previous blog posts"
              disabled
            >
              <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
              </svg>
            </button>
            <button
              type="button"
              class="carousel-next size-9.5 inline-flex items-center justify-center rounded-full border border-gray-200/80 dark:border-gray-800 bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm text-gray-700 dark:text-gray-300 shadow-xs hover:border-accent-500 hover:text-accent-500 dark:hover:border-accent-500 dark:hover:text-accent-400 transition-colors disabled:opacity-35 disabled:cursor-not-allowed cursor-pointer"
              aria-label="Next blog posts"
            >
              <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
              </svg>
            </button>
          </div>
        </div>
      </header>

      <div class="relative mt-8 border-t border-gray-200/80 dark:border-gray-800 pt-8">
        <div
          class="carousel-track no-scrollbar flex gap-8 overflow-x-auto scroll-smooth snap-x snap-mandatory pt-2 pb-6 focus:outline-hidden"
          tabindex="0"
          aria-label="Blog posts carousel"
        >
          {featuredBlogPosts.map(({ post, video, firstParagraph }) => {
            const setupMatch = post.data.title.match(/^Part\s+(\d+)/i);
            const isSetupGuide = Boolean(setupMatch);
            const setupPartLabel = setupMatch
              ? `Setup Guide · Part ${setupMatch[1]}`
              : null;
            return (
              <div class="carousel-item snap-start shrink-0 w-[85%] sm:w-[calc((100%-2rem)/2)] lg:w-[calc((100%-4rem)/3)] flex flex-col">
                <article class="flex h-full flex-col">
                  <div class="mb-3 flex items-center justify-between gap-2">
                    <PostDateMeta
                      pubDate={post.data.pubDate}
                      updatedDate={post.data.updatedDate}
                      class="min-w-0 flex-nowrap truncate"
                    />
                    {setupPartLabel && (
                      <span class="inline-flex shrink-0 whitespace-nowrap items-center gap-1 rounded-md bg-accent-500/15 dark:bg-accent-500/20 px-2 py-0.5 text-[11px] font-semibold text-accent-800 dark:text-accent-400 ring-1 ring-inset ring-accent-500/30">
                        {setupPartLabel}
                      </span>
                    )}
                  </div>
                  <div class:list={[
                    "border-beam-card group relative flex flex-1 flex-col justify-between overflow-hidden rounded-2xl bg-white dark:bg-gray-800 shadow-lg transition hover:shadow-xl",
                    isSetupGuide
                      ? "ring-1 ring-accent-500/30 dark:ring-accent-500/30"
                      : "ring-1 ring-gray-900/5 dark:ring-white/10"
                  ]}>
                    <BlogCardMedia post={post} video={video} />
                    <div class="flex flex-1 flex-col justify-between p-6">
                      <div>
                        <h3 class="text-lg/6 font-semibold text-gray-900 dark:text-white group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors">
                          <a href={`/blog/${post.id}/`}>
                            <span class="absolute inset-0"></span>
                            {post.data.title}
                          </a>
                        </h3>
                        {(!video || post.data.heroImage) && (
                          <p class:list={[
                            'mt-4 text-sm/6 text-gray-600 dark:text-gray-300',
                            hasVideoInFeatured ? 'line-clamp-6 lg:line-clamp-7' : 'line-clamp-3',
                          ]}>
                            <span class="font-medium text-gray-800 dark:text-gray-200">{post.data.description}</span>
                            {hasVideoInFeatured && firstParagraph && (
                              <span class="mt-2 block text-gray-500 dark:text-gray-400">{firstParagraph}</span>
                            )}
                          </p>
                        )}
                      </div>
                      <div class="mt-4 flex flex-wrap items-center justify-between gap-x-3 gap-y-2 border-t border-gray-100 dark:border-gray-700/60 pt-3 text-xs">
                        <div class="relative z-10 min-w-0 max-w-full">
                          <TagList tags={post.data.tags} />
                        </div>
                        <span class="ml-auto inline-flex shrink-0 items-center gap-1 text-gray-500 dark:text-gray-400">
                          <svg class="size-3.5 shrink-0" aria-hidden="true">
                            <use href="#i-clock" />
                          </svg>
                          {getReadingTime(post.body)}
                        </span>
                      </div>
                    </div>
                  </div>
                </article>
              </div>
            );
          })}
        </div>

        <div class="carousel-dots mt-3 flex items-center justify-center gap-0.5" role="group" aria-label="Blog posts carousel pagination">
          {featuredBlogPosts.map((_, i) => (
            <button
              type="button"
              class="carousel-dot group/dot inline-flex min-h-6 min-w-6 items-center justify-center px-1 cursor-pointer rounded-full focus:outline-hidden focus-visible:ring-2 focus-visible:ring-accent-500"
              data-index={i}
              aria-label={`Go to article ${i + 1}`}
              aria-current={i === 0 ? 'true' : undefined}
            >
              <span
                class={`carousel-dot-indicator block h-1.5 rounded-full transition-all duration-300 ${
                  i === 0
                    ? 'w-6 bg-accent-500 dark:bg-accent-400 shadow-xs'
                    : 'w-2 bg-gray-300 dark:bg-gray-700 group-hover/dot:bg-gray-400 dark:group-hover/dot:bg-gray-600'
                }`}
              />
            </button>
          ))}
        </div>
      </div>

      <div class="mt-10 sm:mt-12 flex justify-end">
        <a
          href="/blog/#older-posts"
          class="group inline-flex items-center gap-1.5 text-sm/6 font-semibold text-accent-700 hover:text-accent-600 dark:text-accent-500 dark:hover:text-accent-400 transition-colors"
        >
          <span>{blogSection.footerLinkLabel}</span>
          <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">&rarr;</span>
        </a>
      </div>
    </div>
  </section>
)}
</div>

{showPhotos && (
  <section id="photos" aria-labelledby="home-photo-heading" class="scroll-mt-16 relative isolate overflow-hidden py-24 sm:py-32 transition-colors" data-carousel-container="photos">
    <AmbientGlow preset="home-photos" />
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <header class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-2xl">
          <h2 id="home-photo-heading" class="text-4xl font-semibold tracking-tight text-pretty text-gray-900 dark:text-white sm:text-5xl">
            {photosSection.heading}
          </h2>
          <p class="mt-2 text-lg/8 text-gray-600 dark:text-gray-400">
            {photosSection.subtitle}{' '}
            <a href="/photography/" class="text-sm/6 font-semibold text-accent-700 hover:text-accent-600 dark:text-accent-500 dark:hover:text-accent-400">
              {photosSection.linkLabel} <span aria-hidden="true">&rarr;</span>
            </a>
          </p>
        </div>

        <div class="flex items-center gap-3 shrink-0 self-start sm:self-end">
          <span class="carousel-counter text-xs font-medium text-gray-600 dark:text-gray-300 bg-gray-100 dark:bg-gray-800/80 px-2.5 py-1 rounded-full ring-1 ring-inset ring-gray-200 dark:ring-gray-700">
            1–3 of {featuredPhotos.length}
          </span>
          <div class="flex items-center gap-1.5">
            <button
              type="button"
              class="carousel-prev size-9.5 inline-flex items-center justify-center rounded-full border border-gray-200/80 dark:border-gray-800 bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm text-gray-700 dark:text-gray-300 shadow-xs hover:border-accent-500 hover:text-accent-500 dark:hover:border-accent-500 dark:hover:text-accent-400 transition-colors disabled:opacity-35 disabled:cursor-not-allowed cursor-pointer"
              aria-label="Previous photos"
              disabled
            >
              <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
              </svg>
            </button>
            <button
              type="button"
              class="carousel-next size-9.5 inline-flex items-center justify-center rounded-full border border-gray-200/80 dark:border-gray-800 bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm text-gray-700 dark:text-gray-300 shadow-xs hover:border-accent-500 hover:text-accent-500 dark:hover:border-accent-500 dark:hover:text-accent-400 transition-colors disabled:opacity-35 disabled:cursor-not-allowed cursor-pointer"
              aria-label="Next photos"
            >
              <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
              </svg>
            </button>
          </div>
        </div>
      </header>

      <div class="relative mt-12 sm:mt-14 border-t border-gray-200/80 dark:border-gray-800 pt-12 sm:pt-14">
        <div
          class="carousel-track no-scrollbar flex gap-8 overflow-x-auto scroll-smooth snap-x snap-mandatory pt-2 pb-6 focus:outline-hidden"
          tabindex="0"
          aria-label="Photo Roll carousel"
        >
          {featuredPhotos.map(({ imageData, altText, photo }) => (
            <div class="carousel-item snap-start shrink-0 w-[85%] sm:w-[calc((100%-2rem)/2)] lg:w-[calc((100%-4rem)/3)] flex flex-col">
              <a href={photo ? `/photography/?photo=${photo.id}` : '/photography/'} class="group block h-full">
                <div class="border-beam-card relative w-full h-full overflow-hidden rounded-2xl bg-white dark:bg-gray-800 shadow-lg ring-1 ring-gray-900/5 dark:ring-white/10 transition-all duration-300 hover:shadow-xl">
                  <Image
                    src={imageData}
                    alt={altText}
                    widths={[320, 384, 512, 640]}
                    sizes="(min-width: 1024px) 384px, (min-width: 640px) 45vw, 85vw"
                    quality={60}
                    loading="lazy"
                    decoding="async"
                    class="aspect-video w-full h-full rounded-2xl bg-gray-100 dark:bg-gray-700 object-cover sm:aspect-2/1 lg:aspect-3/2 transition-transform duration-300 group-hover:scale-[1.02]"
                  />
                </div>
              </a>
            </div>
          ))}
        </div>

        <div class="carousel-dots mt-3 flex items-center justify-center gap-0.5" role="group" aria-label="Photo carousel pagination">
          {featuredPhotos.map((_, i) => (
            <button
              type="button"
              class="carousel-dot group/dot inline-flex min-h-6 min-w-6 items-center justify-center px-1 cursor-pointer rounded-full focus:outline-hidden focus-visible:ring-2 focus-visible:ring-accent-500"
              data-index={i}
              aria-label={`Go to photo ${i + 1}`}
              aria-current={i === 0 ? 'true' : undefined}
            >
              <span
                class={`carousel-dot-indicator block h-1.5 rounded-full transition-all duration-300 ${
                  i === 0
                    ? 'w-6 bg-accent-500 dark:bg-accent-400 shadow-xs'
                    : 'w-2 bg-gray-300 dark:bg-gray-700 group-hover/dot:bg-gray-400 dark:group-hover/dot:bg-gray-600'
                }`}
              />
            </button>
          ))}
        </div>
      </div>

      <div class="mt-10 sm:mt-12 flex justify-end">
        <a
          href="/photography/"
          class="group inline-flex items-center gap-1.5 text-sm/6 font-semibold text-accent-700 hover:text-accent-600 dark:text-accent-500 dark:hover:text-accent-400 transition-colors"
        >
          <span>{photosSection.footerLinkLabel}</span>
          <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">&rarr;</span>
        </a>
      </div>
    </div>
  </section>
)}

{showLog && (
  <section id="log" aria-labelledby="home-log-heading" class="scroll-mt-16 relative isolate overflow-hidden bg-gray-50 dark:bg-gray-800/40 border-t border-gray-200/70 dark:border-gray-800 py-24 sm:py-32 transition-colors" data-carousel-container="log">
    <AmbientGlow preset="home-log" />
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <header class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-2xl">
          <h2 id="home-log-heading" class="text-4xl font-semibold tracking-tight text-pretty text-gray-900 dark:text-white sm:text-5xl">
            {logSection.heading}
          </h2>
          <p class="mt-2 text-lg/8 text-gray-600 dark:text-gray-400">
            {logSection.subtitle}{' '}
            <a href="/log/" class="text-sm/6 font-semibold text-accent-700 hover:text-accent-600 dark:text-accent-500 dark:hover:text-accent-400">
              {logSection.linkLabel} <span aria-hidden="true">&rarr;</span>
            </a>
          </p>
        </div>

        <div class="flex items-center gap-3 shrink-0 self-start sm:self-end">
          <span class="carousel-counter text-xs font-medium text-gray-600 dark:text-gray-300 bg-gray-100 dark:bg-gray-800/80 px-2.5 py-1 rounded-full ring-1 ring-inset ring-gray-200 dark:ring-gray-700">
            1–3 of {logEntries.length}
          </span>
          <div class="flex items-center gap-1.5">
            <button
              type="button"
              class="carousel-prev size-9.5 inline-flex items-center justify-center rounded-full border border-gray-200/80 dark:border-gray-800 bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm text-gray-700 dark:text-gray-300 shadow-xs hover:border-accent-500 hover:text-accent-500 dark:hover:border-accent-500 dark:hover:text-accent-400 transition-colors disabled:opacity-35 disabled:cursor-not-allowed cursor-pointer"
              aria-label="Previous log entries"
              disabled
            >
              <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
              </svg>
            </button>
            <button
              type="button"
              class="carousel-next size-9.5 inline-flex items-center justify-center rounded-full border border-gray-200/80 dark:border-gray-800 bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm text-gray-700 dark:text-gray-300 shadow-xs hover:border-accent-500 hover:text-accent-500 dark:hover:border-accent-500 dark:hover:text-accent-400 transition-colors disabled:opacity-35 disabled:cursor-not-allowed cursor-pointer"
              aria-label="Next log entries"
            >
              <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
              </svg>
            </button>
          </div>
        </div>
      </header>

      <div class="relative mt-12 sm:mt-14 border-t border-gray-200/80 dark:border-gray-800 pt-12 sm:pt-14">
        <div
          class="carousel-track no-scrollbar flex gap-8 overflow-x-auto scroll-smooth snap-x snap-mandatory pt-2 pb-6 focus:outline-hidden"
          tabindex="0"
          aria-label="Log entries carousel"
        >
          {logEntries.map((entry) => {
            const anchorId = entry.id;
            return (
              <div class="carousel-item snap-start shrink-0 w-[85%] sm:w-[calc((100%-2rem)/2)] lg:w-[calc((100%-4rem)/3)] flex flex-col">
                <article class="flex h-full flex-col">
                  <div class="mb-3 flex items-center gap-x-3 text-xs">
                    <FormattedDate date={entry.date} />
                    {entry.kind === 'note' && (
                      <span class="log-badge">
                        <svg class="size-3 text-gray-500 dark:text-gray-400" aria-hidden="true">
                          <use href="#i-chat" />
                        </svg>
                        <span>Status-Update</span>
                      </span>
                    )}
                    {entry.kind === 'changelog' && (
                      <span class="log-badge">
                        <svg class="size-3 text-gray-500 dark:text-gray-400" aria-hidden="true">
                          <use href="#i-check" />
                        </svg>
                        <span>Changelog</span>
                      </span>
                    )}
                    {entry.kind === 'photo' && (
                      <span class="log-badge">
                        <svg class="size-3 text-gray-500 dark:text-gray-400" aria-hidden="true">
                          <use href="#i-camera" />
                        </svg>
                        <span>Photo</span>
                      </span>
                    )}
                  </div>

                  {entry.kind === 'photo' && entry.imageData ? (
                    <div class="border-beam-card group relative flex flex-1 flex-col justify-end overflow-hidden rounded-2xl bg-gray-900 shadow-lg ring-1 ring-gray-900/5 dark:ring-white/10 transition hover:shadow-xl min-h-[13.5rem] cursor-pointer">
                      <a
                        href={entry.photoId ? getGalleryPhotoHref(entry.photoId) : '/photography/'}
                        aria-label={`View ${entry.title} in photo gallery`}
                        class="absolute inset-0 z-10 rounded-2xl focus:outline-hidden focus-visible:ring-2 focus-visible:ring-accent-500"
                      ></a>
                      <Image
                        src={entry.imageData}
                        alt={entry.title}
                        widths={[320, 384, 512, 640]}
                        sizes="(min-width: 1024px) 384px, (min-width: 640px) 45vw, 85vw"
                        quality={60}
                        loading="lazy"
                        decoding="async"
                        class="pointer-events-none absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                      />
                      <div
                        class="pointer-events-none absolute inset-0 bg-gradient-to-t from-gray-950/90 via-gray-950/45 to-gray-950/10 transition-opacity duration-300 group-hover:from-gray-950/95"
                        aria-hidden="true"
                      ></div>
                      <div class="pointer-events-none relative z-20 flex flex-col justify-end p-5 sm:p-6">
                        <h3 class="text-lg/6 font-semibold text-white group-hover:text-accent-300 transition-colors drop-shadow-xs">
                          {entry.title}
                        </h3>
                        {entry.excerpt && (
                          <p class="mt-1.5 line-clamp-1 text-xs/5 text-gray-200/90 drop-shadow-xs">
                            {entry.excerpt}
                          </p>
                        )}
                        <div class="mt-3 flex items-center justify-between gap-3 border-t border-white/15 pt-3 text-xs">
                          <div class="pointer-events-auto relative z-30 min-w-0 flex-1 overflow-hidden [&_a]:!bg-gray-900/65 [&_a]:!text-gray-100 [&_a]:!ring-white/20 [&_a:hover]:!bg-accent-500/30 [&_a:hover]:!text-accent-200 [&_a]:backdrop-blur-xs">
                            {entry.tags && entry.tags.length > 0 && (
                              <TagList tags={entry.tags} limit={3} singleLine={true} />
                            )}
                          </div>
                          <span class="inline-flex shrink-0 items-center gap-1 text-xs font-semibold text-accent-400 group-hover:text-accent-300 transition-colors drop-shadow-xs">
                            View in gallery <span aria-hidden="true">&rarr;</span>
                          </span>
                        </div>
                      </div>
                    </div>
                  ) : (
                    <div class="border-beam-card group relative flex flex-1 flex-col justify-between rounded-2xl bg-white dark:bg-gray-800 p-6 shadow-lg ring-1 ring-gray-900/5 dark:ring-white/10 transition hover:shadow-xl">
                      <div>
                        <h3 class="text-lg/6 font-semibold text-gray-900 dark:text-white group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors">
                          <a href={`/log/#${anchorId}`}>
                            <span class="absolute inset-0"></span>
                            {entry.title}
                          </a>
                        </h3>
                        <p class="mt-4 line-clamp-3 text-sm/6 text-gray-600 dark:text-gray-300">
                          {entry.excerpt}
                        </p>
                      </div>
                      <div class="mt-4 flex items-center justify-between gap-3 border-t border-gray-100 dark:border-gray-700/60 pt-3 text-xs">
                        <div class="relative z-10 min-w-0 flex-1 overflow-hidden">
                          {entry.tags && entry.tags.length > 0 && (
                            <TagList tags={entry.tags} limit={3} singleLine={true} />
                          )}
                        </div>
                        <span class="inline-flex shrink-0 items-center gap-1 text-xs font-semibold text-accent-700 group-hover:text-accent-600 dark:text-accent-500 dark:group-hover:text-accent-400 transition-colors">
                          Read in log <span aria-hidden="true">&rarr;</span>
                        </span>
                      </div>
                    </div>
                  )}
                  <AuthorChip />
                </article>
              </div>
            );
          })}
        </div>

        <div class="carousel-dots mt-3 flex items-center justify-center gap-0.5" role="group" aria-label="Log entries carousel pagination">
          {logEntries.map((_, i) => (
            <button
              type="button"
              class="carousel-dot group/dot inline-flex min-h-6 min-w-6 items-center justify-center px-1 cursor-pointer rounded-full focus:outline-hidden focus-visible:ring-2 focus-visible:ring-accent-500"
              data-index={i}
              aria-label={`Go to log entry ${i + 1}`}
              aria-current={i === 0 ? 'true' : undefined}
            >
              <span
                class={`carousel-dot-indicator block h-1.5 rounded-full transition-all duration-300 ${
                  i === 0
                    ? 'w-6 bg-accent-500 dark:bg-accent-400 shadow-xs'
                    : 'w-2 bg-gray-300 dark:bg-gray-700 group-hover/dot:bg-gray-400 dark:group-hover/dot:bg-gray-600'
                }`}
              />
            </button>
          ))}
        </div>
      </div>

      <div class="mt-10 sm:mt-12 flex justify-end">
        <a
          href="/log/"
          class="group inline-flex items-center gap-1.5 text-sm/6 font-semibold text-accent-700 hover:text-accent-600 dark:text-accent-500 dark:hover:text-accent-400 transition-colors"
        >
          <span>{logSection.footerLinkLabel}</span>
          <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">&rarr;</span>
        </a>
      </div>
    </div>
  </section>
)}

{(showBlog || showPhotos || showLog) && <CarouselScript />}
</BaseLayout>
