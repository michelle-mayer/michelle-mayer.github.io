---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AmbientGlow from '../../components/AmbientGlow.astro';
import AuthorChip from '../../components/AuthorChip.astro';
import PostDateMeta from '../../components/PostDateMeta.astro';
import SectionNav from '../SectionNav.astro';
import PaginationControls from '../PaginationControls.astro';
import { getCollection, getEntry } from 'astro:content';
import TagList from '../TagList.astro';
import BlogCardMedia from '../BlogCardMedia.astro';
import { getReadingTime } from '../../utils/readingTime';
import { getFirstVideoEmbed } from '../../utils/postVideo';
import { OLDER_BLOGS_PAGE_SIZE } from '../../utils/pagination';
import { BLOG_CATEGORIES, BLOG_CATEGORY_DETAILS, blogCategoryHref, type BlogCategory } from '../../utils/blogCategories';

interface Props {
  currentPage?: number;
  category?: BlogCategory;
}

const { currentPage = 1, category } = Astro.props;

function getArticleIntroParagraphs(body: string | undefined): string[] {
  if (!body) return [];
  const cleanBody = body
    .replace(/^---[\s\S]*?---\s*/, '')
    .replace(/```[\s\S]*?```/g, '');
  const rawParagraphs = cleanBody
    .split(/\n\s*\n/)
    .map((p) => p.trim())
    .filter(
      (p) =>
        p &&
        !p.startsWith('>') &&
        !p.startsWith('#') &&
        !p.startsWith('---') &&
        !p.startsWith('```') &&
        !p.startsWith('|') &&
        !p.startsWith('!['),
    )
    .map((p) =>
      p
        .replace(/<abbr>([^<]+)<\/abbr>/g, '$1')
        .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
        .replace(/[`*_]/g, '')
        .replace(/\s+/g, ' ')
        .trim(),
    )
    .filter((p) => p.length > 0);

  return rawParagraphs.slice(0, 10);
}

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const posts = category ? allPosts.filter((post) => post.data.category === category) : allPosts;

const isInitialView = currentPage === 1;
const featuredVideo = isInitialView && posts[0] ? await getFirstVideoEmbed(posts[0].body) : null;
const rightColPosts = isInitialView
  ? await Promise.all(
      posts.slice(1, 3).map(async (post) => ({
        post,
        video: await getFirstVideoEmbed(post.body),
      }))
    )
  : [];
const olderPosts = posts.slice(3);
const startIdx = (currentPage - 1) * OLDER_BLOGS_PAGE_SIZE;
const paginatedOlderPosts = olderPosts.slice(startIdx, startIdx + OLDER_BLOGS_PAGE_SIZE);
const paginatedOlderPostsWithVideo = await Promise.all(
  paginatedOlderPosts.map(async (post) => ({
    post,
    video: await getFirstVideoEmbed(post.body),
  }))
);

const blogPageEntry = await getEntry('pages', 'blog');
const blogPageData = blogPageEntry!.data;
const categoryDetails = category ? BLOG_CATEGORY_DETAILS[category] : undefined;
const basePath = category ? blogCategoryHref(category).replace(/\/$/, '') : '/blog';
const titleBase = categoryDetails
  ? `${blogPageData.pageTitle} - ${categoryDetails.label}`
  : blogPageData.pageTitle;
const pageTitle = isInitialView
  ? titleBase
  : `${titleBase} (Page ${currentPage})`;
const description = categoryDetails?.description ?? blogPageData.description;
const breadcrumbs = [
  { name: 'Blog', href: category || !isInitialView ? '/blog/' : undefined },
  ...(categoryDetails ? [{ name: categoryDetails.label, href: isInitialView ? undefined : `${basePath}/` }] : []),
  ...(!isInitialView ? [{ name: `Page ${currentPage}` }] : []),
];
const categoryFilters = [
  { label: 'All', href: '/blog/', active: !category, count: allPosts.length },
  ...BLOG_CATEGORIES.map((value) => ({
    label: BLOG_CATEGORY_DETAILS[value].label,
    href: blogCategoryHref(value),
    active: category === value,
    count: allPosts.filter((post) => post.data.category === value).length,
  })),
];

const blogSections = [
  ...(posts.length > 0 ? [{ id: 'featured', label: 'Featured' }] : []),
  ...(olderPosts.length > 0 ? [{ id: 'older-posts', label: 'Older Posts' }] : []),
];
---

<BaseLayout
  pageTitle={pageTitle}
  description={description}
  image="/og/blog.jpg"
  type="blog"
  breadcrumbs={breadcrumbs}
>
  {isInitialView && posts.length > 0 && (
    <SectionNav sections={blogSections} slot="breadcrumb-extra" ariaLabel="Blog page sections" />
  )}

  <section aria-labelledby="blog-list-heading" class="mx-auto max-w-7xl px-6 pt-16 lg:px-8">
    <h1 id="blog-list-heading" class="text-4xl font-semibold tracking-tight text-gray-900 dark:text-white sm:text-5xl">
      {categoryDetails ? `${categoryDetails.label} posts` : 'Blog'}
    </h1>
    <p class="mt-3 max-w-2xl text-lg/8 text-gray-600 dark:text-gray-400">{description}</p>
    <nav aria-label="Blog categories" class="mt-6 flex flex-wrap gap-3">
      {categoryFilters.map((filter) => (
        <a
          href={filter.href}
          aria-current={filter.active ? 'page' : undefined}
          class:list={[
            'inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-semibold ring-1 ring-inset transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-600',
            filter.active
              ? 'bg-accent-700 text-white ring-accent-700'
              : 'bg-white text-gray-700 ring-gray-200 hover:bg-accent-50 hover:text-accent-800 dark:bg-gray-800 dark:text-gray-200 dark:ring-gray-700 dark:hover:bg-gray-700',
          ]}
        >
          {filter.label}
          <span class="rounded-full bg-black/10 px-2 py-0.5 text-xs dark:bg-white/10">{filter.count}</span>
        </a>
      ))}
    </nav>
  </section>

  {posts.length === 0 && (
    <div class="mx-auto max-w-7xl px-6 py-24 lg:px-8">
      <p class="text-lg text-gray-600 dark:text-gray-400">
        No {categoryDetails?.label ?? 'blog'} posts yet. Check back for new writing, or
        {' '}<a href="/blog/" class="font-semibold text-accent-700 underline dark:text-accent-400">browse all posts</a>.
      </p>
    </div>
  )}

  {isInitialView && posts.length > 0 && (
    <section id="featured" aria-label="Featured articles" class="scroll-mt-16 relative isolate overflow-hidden py-24 sm:py-32">
      <AmbientGlow preset="blog-top" />

      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class:list={['grid grid-cols-1 gap-12 lg:items-stretch lg:gap-8', posts.length > 1 && 'lg:grid-cols-12']}>
          {posts.slice(0, 1).map((post) => {
            const introParagraphs = getArticleIntroParagraphs(post.body).slice(0, rightColPosts.length > 0 ? 10 : 2);
            return (
              <article id="featured-article" class:list={['mx-auto flex h-full w-full max-w-2xl flex-col', posts.length > 1 ? 'lg:col-span-6 lg:max-w-none' : 'lg:max-w-3xl']}>
                <PostDateMeta
                  pubDate={post.data.pubDate}
                  updatedDate={post.data.updatedDate}
                  class="mb-3 shrink-0"
                />
                <div class="border-beam-card group relative flex flex-1 flex-col justify-between overflow-hidden rounded-2xl bg-white/85 dark:bg-gray-800/85 shadow-lg ring-1 ring-gray-900/5 dark:ring-white/10 backdrop-blur-sm transition hover:shadow-xl">
                  <BlogCardMedia post={post} video={featuredVideo} loading="eager" badgeLabel="Featured Video" playButtonSize="lg" />
                  <div class="flex min-h-0 flex-1 flex-col justify-between p-6">
                    <div class="flex min-h-0 flex-1 flex-col">
                      <h2 class="text-3xl font-semibold tracking-tight text-pretty text-gray-900 dark:text-white group-hover:text-accent-600 dark:group-hover:text-accent-400 sm:text-4xl">
                        <a href={`/blog/${post.id}/`}>
                          <span class="absolute inset-0"></span>
                          {post.data.title}
                        </a>
                      </h2>
                      <p id="featured-desc" class="mt-4 shrink-0 text-base/7 font-medium text-gray-600 dark:text-gray-300">
                        {post.data.description}
                      </p>
                      {introParagraphs.length > 0 && (
                        <div
                          id="featured-preview-container"
                          class:list={[
                            'mt-4 border-t border-gray-100 dark:border-gray-700/60 pt-4 text-sm/6 text-gray-500 dark:text-gray-400',
                            rightColPosts.length > 0 && 'lg:relative lg:min-h-0 lg:flex-1 lg:overflow-hidden lg:[mask-image:linear-gradient(to_bottom,black_calc(100%-2rem),transparent)]',
                          ]}
                        >
                          <div class:list={['space-y-3', rightColPosts.length > 0 && 'lg:absolute lg:inset-x-0 lg:top-4 lg:bottom-0 lg:overflow-hidden']}>
                            {introParagraphs.map((para, pIdx) => (
                              <p data-preview-idx={pIdx} class={pIdx > 0 ? 'hidden lg:block' : 'line-clamp-2 lg:line-clamp-none'}>{para}</p>
                            ))}
                          </div>
                        </div>
                      )}
                    </div>
                    <div id="featured-footer" class="mt-6 flex shrink-0 flex-wrap items-center justify-between gap-3 border-t border-gray-100 dark:border-gray-700/60 pt-3 text-xs">
                      <div class="relative z-10">
                        <TagList tags={post.data.tags} limit={3} />
                      </div>
                      <div class="flex items-center gap-3">
                        <span class="inline-flex items-center gap-1 text-gray-500 dark:text-gray-400">
                          <svg class="size-3.5 shrink-0" aria-hidden="true"><use href="#i-clock" /></svg>
                          {getReadingTime(post.body)}
                        </span>
                        <span class="inline-flex items-center gap-1 text-sm font-semibold text-accent-700 dark:text-accent-500 group-hover:text-accent-600 dark:group-hover:text-accent-400">
                          <span>Read</span>
                          <span aria-hidden="true">&rarr;</span>
                        </span>
                      </div>
                    </div>
                  </div>
                </div>
                <AuthorChip author={post.data.author} loading="eager" class="mt-6 shrink-0" />
              </article>
            );
          })}

          {rightColPosts.length > 0 && (
          <div class="mx-auto flex h-full w-full max-w-2xl flex-col max-lg:border-t max-lg:border-gray-200/80 dark:max-lg:border-gray-800 max-lg:pt-12 lg:col-span-6 lg:max-w-none">
            <div id="blog-right-col" class="flex flex-1 flex-col justify-between gap-10">
              {rightColPosts.map(({ post, video }, rightIdx) => {
                return (
                <article class="flex max-w-xl flex-1 flex-col">
                  <PostDateMeta
                    pubDate={post.data.pubDate}
                    updatedDate={post.data.updatedDate}
                    class="mb-3"
                  />
                  <div class="border-beam-card group relative flex max-w-xl flex-1 flex-col justify-between overflow-hidden rounded-2xl bg-white/85 dark:bg-gray-800/85 shadow-lg ring-1 ring-gray-900/5 dark:ring-white/10 backdrop-blur-sm transition hover:shadow-xl">
                    <BlogCardMedia post={post} video={video} />
                    <div class="flex flex-1 flex-col justify-between p-6">
                      <div>
                        <h2 class="text-lg font-semibold text-gray-900 dark:text-white group-hover:text-accent-600 dark:group-hover:text-accent-400">
                          <a href={`/blog/${post.id}/`}>
                            <span class="absolute inset-0"></span>
                            {post.data.title}
                          </a>
                        </h2>
                        {(!video || post.data.heroImage) && (
                          <p class="mt-4 text-sm/6 text-gray-600 dark:text-gray-300">{post.data.description}</p>
                        )}
                      </div>
                      <div class="mt-4 flex items-center justify-between gap-3 border-t border-gray-100 dark:border-gray-700/60 pt-3 text-xs">
                        <div class="relative z-10 min-w-0 flex-1 overflow-hidden">
                          <TagList tags={post.data.tags} limit={3} singleLine={true} />
                        </div>
                        <span class="inline-flex shrink-0 items-center gap-1 text-gray-500 dark:text-gray-400">
                          <svg class="size-3.5 shrink-0" aria-hidden="true"><use href="#i-clock" /></svg>
                          {getReadingTime(post.body)}
                        </span>
                      </div>
                    </div>
                  </div>
                  <AuthorChip author={post.data.author} loading={rightIdx === 0 ? 'eager' : 'lazy'} />
                </article>
                );
              })}
            </div>
          </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- Older blogs section with demarking background on Page 1 and standalone clean canvas on Pages 2+ -->
  {olderPosts.length > 0 && (
  <div
    id="older-posts"
    class:list={[
      'relative isolate overflow-hidden py-24 sm:py-32 transition-colors scroll-mt-16',
      isInitialView &&
        'bg-gray-50/75 dark:bg-gray-800/35 border-t border-gray-200/75 dark:border-gray-800/80',
    ]}
  >
    <AmbientGlow preset="blog-archive" />

    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-4xl font-semibold tracking-tight text-pretty text-gray-900 dark:text-white sm:text-5xl">
          {categoryDetails ? `Older ${categoryDetails.label} posts` : blogPageData.heading ?? 'Older blog posts'}
        </h2>
        <p class="mt-2 text-lg/8 text-gray-600 dark:text-gray-400">
          {blogPageData.subtitle}
        </p>
        {!isInitialView && (
          <div class="mt-4">
            <a
              href={`${basePath}/`}
              class="inline-flex items-center gap-1.5 text-sm font-semibold text-accent-700 dark:text-accent-400 hover:text-accent-600 dark:hover:text-accent-300 transition-colors"
            >
              <span aria-hidden="true">&larr;</span>
              <span>Back to latest featured articles</span>
            </a>
          </div>
        )}
      </div>

      <!-- Timeline Stream matching /log/ style -->
      <div class="w-full mt-12 sm:mt-16">
        <div class="relative ml-4 sm:ml-6 pl-6 sm:pl-8 space-y-12">
          <!-- Continuous vertical spine line -->
          <div
            class="absolute left-0 top-2 bottom-2 w-0.5 bg-gradient-to-b from-accent-500 via-accent-400/60 to-gray-300 dark:via-accent-500/40 dark:to-gray-700"
            aria-hidden="true"
          ></div>

          {paginatedOlderPostsWithVideo.map(({ post, video }) => {
            return (
            <article class="relative group/entry">
              <!-- Timeline dot node aligned with the date -->
              <div
                class="absolute -left-6 sm:-left-8 ml-[1px] -translate-x-1/2 top-1 size-3.5 rounded-full bg-accent-600 dark:bg-accent-500 ring-4 ring-white dark:ring-gray-900 shadow-xs"
                aria-hidden="true"
              ></div>

              <!-- Date & Badge above the card -->
              <PostDateMeta
                pubDate={post.data.pubDate}
                updatedDate={post.data.updatedDate}
                class="mb-3"
              />

              <!-- Card -->
              <div class="border-beam-card group relative overflow-hidden rounded-2xl shadow-md ring-1 ring-gray-900/5 dark:ring-white/10 bg-white/85 dark:bg-gray-800/85 backdrop-blur-sm transition hover:shadow-xl">
                  <div class="md:grid md:grid-cols-12 md:items-stretch">
                    <div class="md:col-span-5 relative overflow-hidden">
                      <BlogCardMedia
                        post={post}
                        video={video}
                        aspectClass="aspect-video md:aspect-auto h-full min-h-56"
                      />
                    </div>
                    <div class="md:col-span-7 relative flex flex-col justify-between p-6 sm:p-7">
                      <div>
                        <h3 class="text-xl sm:text-2xl font-semibold tracking-tight text-gray-900 dark:text-white group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors">
                          <a href={`/blog/${post.id}/`}>
                            <span class="absolute inset-0"></span>
                            {post.data.title}
                          </a>
                        </h3>
                        <p class="mt-3 text-sm/6 sm:text-base/7 text-gray-600 dark:text-gray-300 line-clamp-3">
                          {post.data.description}
                        </p>
                      </div>

                      <!-- Footer toolbar: tags, reading time, and read link -->
                      <div class="mt-6 pt-4 border-t border-gray-100 dark:border-gray-700/60 flex flex-wrap items-center justify-between gap-3 text-xs">
                        <div class="relative z-10">
                          <TagList tags={post.data.tags} limit={4} />
                        </div>
                        <div class="flex items-center gap-3">
                          <span class="inline-flex items-center gap-1 text-gray-500 dark:text-gray-400 shrink-0">
                            <svg class="size-3.5 shrink-0" aria-hidden="true"><use href="#i-clock" /></svg>
                            {getReadingTime(post.body)}
                          </span>
                          <span class="text-sm font-semibold text-accent-700 dark:text-accent-500 group-hover:text-accent-600 dark:group-hover:text-accent-400 inline-flex items-center gap-1">
                            <span>Read</span>
                            <span aria-hidden="true">&rarr;</span>
                          </span>
                        </div>
                      </div>
                    </div>
                  </div>
              </div>

              <!-- Author attribution -->
              <AuthorChip author={post.data.author} class="mt-4" />
            </article>
            );
          })}
        </div>

        <PaginationControls
          currentPage={currentPage}
          totalItems={olderPosts.length}
          pageSize={OLDER_BLOGS_PAGE_SIZE}
          featuredCount={Math.min(3, posts.length)}
          basePath={basePath}
          firstPageHash="#older-posts"
          itemLabel="articles"
          ariaLabel="Older blog posts pagination"
          class="mt-12"
        />
      </div>
    </div>
  </div>
  )}
</BaseLayout>
