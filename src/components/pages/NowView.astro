---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AmbientGlow from '../AmbientGlow.astro';
import PathsForward from '../PathsForward.astro';
import Tooltip from '../Tooltip.astro';
import SectionNav from '../SectionNav.astro';
import { getEntry } from 'astro:content';

const nowEntry = await getEntry('pages', 'now');
const nowData = nowEntry!.data;
const pageTitle = nowData.pageTitle;
const description = nowData.description;
const lastUpdated = nowData.lastUpdated ?? '';
const nowSections = nowData.nowSections ?? [];

function splitByAbbr(html: string): { isAbbr: boolean; value: string }[] {
  const parts = html.split(/<abbr>([^<]+)<\/abbr>/g);
  return parts.map((value, idx) => ({
    isAbbr: idx % 2 === 1,
    value,
  }));
}
---

<BaseLayout
  pageTitle={pageTitle}
  description={description}
  image="/og/now.jpg"
  imageAlt={pageTitle}
  breadcrumbs={[{ name: 'Now' }]}
>
  <!-- Floating Back to Top Button on scroll -->
  <SectionNav slot="breadcrumb-extra" />

  <div class="relative isolate overflow-hidden py-24 sm:py-32">
    <AmbientGlow preset="now" />

    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <!-- Header Card -->
      <div class="w-full rounded-2xl p-8 sm:p-12 shadow-lg ring-1 ring-gray-900/5 bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm dark:ring-white/10 space-y-6">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="inline-flex items-center gap-2 rounded-full bg-amber-50 dark:bg-gray-700/60 px-3 py-1 text-xs font-semibold text-amber-700 dark:text-amber-500 ring-1 ring-inset ring-amber-600/20 dark:ring-amber-500/30">
            <span class="inline-flex size-2 rounded-full bg-amber-600 dark:bg-amber-400 animate-pulse"></span>
            <span>{nowData.badge ?? 'Current snapshot'}</span>
          </div>
          <span class="text-xs font-mono text-gray-500 dark:text-gray-400">
            Last updated: <span class="font-semibold text-gray-700 dark:text-gray-200">{lastUpdated}</span>
          </span>
        </div>

        <div>
          <h1 class="text-4xl font-semibold tracking-tight text-gray-900 dark:text-white sm:text-5xl">{nowData.heading}</h1>
          {nowData.introHtml && (
            <p class="mt-4 text-xl/8 text-gray-600 dark:text-gray-300" set:html={nowData.introHtml} />
          )}
        </div>
      </div>

      <!-- Content Sections Grid -->
      <div class="w-full mt-10 space-y-8">
        {nowSections.map((section) => (
          <section class:list={[
            'rounded-2xl p-8 sm:p-10 shadow-lg ring-1 ring-gray-900/5 bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm dark:ring-white/10',
            section.subsections ? 'space-y-6' : 'space-y-4',
          ]}>
            <div class="flex items-center gap-3 text-amber-600 dark:text-amber-500">
              {section.icon === 'location' && (
                <svg class="size-6 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                </svg>
              )}
              {section.icon === 'engineering' && (
                <svg class="size-6 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0a3 3 0 0 1-3-3m3 3a3 3 0 1 0 0 6h13.5a3 3 0 1 0 0-6m-16.5-3a3 3 0 0 1 3-3h13.5a3 3 0 0 1 3 3m-19.5 0a4.5 4.5 0 0 1 .9-2.7L5.75 5.1a3 3 0 0 1 2.4-1.1h7.7a3 3 0 0 1 2.4 1.1l2.1 3.45a4.5 4.5 0 0 1 .9 2.7" />
                </svg>
              )}
              {section.icon === 'homelab' && (
                <svg class="size-6 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 3v1.5M4.5 8.25H3m18 0h-1.5M4.5 12H3m18 0h-1.5m-15 3.75H3m18 0h-1.5M8.25 19.5V21M12 3v1.5m0 15V21m3.75-18v1.5m0 15V21m-9-1.5h10.5a2.25 2.25 0 0 0 2.25-2.25V5.25a2.25 2.25 0 0 0-2.25-2.25H6.75A2.25 2.25 0 0 0 4.5 5.25v13.5A2.25 2.25 0 0 0 6.75 21Z" />
                </svg>
              )}
              {section.icon === 'offline' && (
                <svg class="size-6 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
                </svg>
              )}
              {section.icon === 'reading' && (
                <svg class="size-6 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
                </svg>
              )}
              <h2 class="text-2xl font-semibold tracking-tight text-gray-900 dark:text-white">{section.title}</h2>
            </div>

            {section.paragraphs && section.paragraphs.map((para) => (
              <p class="text-base/7 text-gray-600 dark:text-gray-300">
                {splitByAbbr(para).map((part) =>
                  part.isAbbr ? <Tooltip>{part.value}</Tooltip> : <Fragment set:html={part.value} />
                )}
              </p>
            ))}

            {section.subsections && (
              <div class="space-y-6 text-base/7 text-gray-600 dark:text-gray-300">
                {section.subsections.map((sub) => (
                  <div>
                    <h3 class="font-semibold text-gray-900 dark:text-white flex items-center gap-2">
                      <span class="size-1.5 rounded-full bg-amber-600 dark:bg-amber-400" aria-hidden="true"></span>
                      <span>{sub.title}</span>
                    </h3>
                    {sub.paragraphs.length === 1 ? (
                      <p class="mt-1">
                        {splitByAbbr(sub.paragraphs[0]).map((part) =>
                          part.isAbbr ? <Tooltip>{part.value}</Tooltip> : <Fragment set:html={part.value} />
                        )}
                      </p>
                    ) : (
                      <div class="mt-1 space-y-3">
                        {sub.paragraphs.map((para) => (
                          <p>
                            {splitByAbbr(para).map((part) =>
                              part.isAbbr ? <Tooltip>{part.value}</Tooltip> : <Fragment set:html={part.value} />
                            )}
                          </p>
                        ))}
                      </div>
                    )}
                  </div>
                ))}
              </div>
            )}
          </section>
        ))}

        <!-- Now Movement Note & Paths Forward -->
        <PathsForward variant="now" />

      </div>
    </div>
  </div>
</BaseLayout>
