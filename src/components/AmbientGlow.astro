---
export type GlowPreset =
  | 'home-top'
  | 'home-bottom'
  | 'home-photos'
  | 'home-blog'
  | 'home-log'
  | 'about'
  | 'now'
  | 'log'
  | 'blog-top'
  | 'blog-archive'
  | 'photography'
  | 'contact'
  | 'tags-index'
  | 'tag-detail'
  | '404'
  | 'blog-post';

interface Props {
  preset: GlowPreset;
  class?: string;
}

interface GlowAtmosphere {
  placement: 'top' | 'bottom' | 'full';
  lightGradient: string;
  darkGradient: string;
  fadeMask: string;
}

const TOP_FADE =
  'linear-gradient(180deg, rgba(0,0,0,1) 0%, rgba(0,0,0,0.72) 52%, rgba(0,0,0,0) 100%)';
const SOFT_TOP_FADE =
  'linear-gradient(180deg, rgba(0,0,0,0.88) 0%, rgba(0,0,0,0.55) 48%, rgba(0,0,0,0) 100%)';
const BOTTOM_FADE =
  'linear-gradient(0deg, rgba(0,0,0,0.82) 0%, rgba(0,0,0,0.45) 50%, rgba(0,0,0,0) 100%)';
const SECTION_FADE =
  'linear-gradient(180deg, rgba(0,0,0,1) 0%, rgba(0,0,0,0.75) 55%, rgba(0,0,0,0.25) 100%)';

// Lavender palette: every glow mixes these soft tints (RGB for light and dark themes).
const TINTS = {
  lavender: { light: '167, 139, 250', dark: '139, 92, 246' },
  blush: { light: '249, 168, 212', dark: '168, 85, 150' },
  sky: { light: '125, 211, 252', dark: '56, 189, 248' },
} as const;
type Tint = keyof typeof TINTS;

function blend(main: Tint, mainAt: string, accent?: Tint, accentAt?: string) {
  const second = (theme: 'light' | 'dark', alpha: number) =>
    accent && accentAt
      ? `, radial-gradient(ellipse 46% 52% at ${accentAt}, rgba(${TINTS[accent][theme]}, ${alpha}) 0%, transparent 72%)`
      : '';
  return {
    lightGradient: `radial-gradient(ellipse 58% 68% at ${mainAt}, rgba(${TINTS[main].light}, 0.24) 0%, rgba(${TINTS[main].light}, 0.1) 52%, transparent 80%)${second('light', 0.16)}`,
    darkGradient: `radial-gradient(ellipse 60% 70% at ${mainAt}, rgba(${TINTS[main].dark}, 0.24) 0%, rgba(${TINTS[main].dark}, 0.12) 55%, transparent 82%)${second('dark', 0.12)}`,
  };
}

const ATMOSPHERES: Record<GlowPreset, GlowAtmosphere> = {
  'home-top': { placement: 'top', ...blend('lavender', '28% 10%', 'sky', '74% 8%'), fadeMask: TOP_FADE },
  'home-bottom': { placement: 'bottom', ...blend('blush', '76% 85%'), fadeMask: BOTTOM_FADE },
  'home-photos': { placement: 'full', ...blend('sky', '80% 20%', 'lavender', '18% 78%'), fadeMask: SECTION_FADE },
  'home-blog': { placement: 'full', ...blend('lavender', '16% 22%', 'sky', '84% 74%'), fadeMask: SECTION_FADE },
  'home-log': { placement: 'full', ...blend('lavender', '76% 20%', 'blush', '20% 80%'), fadeMask: SECTION_FADE },
  about: { placement: 'top', ...blend('lavender', '26% 12%', 'sky', '76% 10%'), fadeMask: TOP_FADE },
  now: { placement: 'top', ...blend('lavender', '30% 12%', 'blush', '72% 8%'), fadeMask: TOP_FADE },
  log: { placement: 'top', ...blend('lavender', '30% 12%', 'blush', '72% 10%'), fadeMask: TOP_FADE },
  'blog-top': { placement: 'top', ...blend('lavender', '26% 12%', 'blush', '76% 10%'), fadeMask: TOP_FADE },
  'blog-archive': { placement: 'top', ...blend('lavender', '72% 10%'), fadeMask: SOFT_TOP_FADE },
  photography: { placement: 'top', ...blend('sky', '24% 12%', 'lavender', '76% 10%'), fadeMask: TOP_FADE },
  contact: { placement: 'top', ...blend('sky', '28% 12%', 'lavender', '74% 10%'), fadeMask: TOP_FADE },
  'tags-index': { placement: 'top', ...blend('lavender', '30% 12%', 'sky', '74% 10%'), fadeMask: TOP_FADE },
  'tag-detail': { placement: 'top', ...blend('lavender', '28% 12%', 'sky', '74% 10%'), fadeMask: TOP_FADE },
  '404': { placement: 'top', ...blend('blush', '34% 16%', 'lavender', '68% 18%'), fadeMask: TOP_FADE },
  'blog-post': { placement: 'top', ...blend('lavender', '28% 10%', 'blush', '70% 14%'), fadeMask: SOFT_TOP_FADE },
};

const config = ATMOSPHERES[Astro.props.preset];
const inlineVars = [
  `--ambient-light: ${config.lightGradient}`,
  `--ambient-dark: ${config.darkGradient}`,
  `mask-image: ${config.fadeMask}`,
  `-webkit-mask-image: ${config.fadeMask}`,
].join('; ');
---

<div
  aria-hidden="true"
  class:list={[
    'ambient-atmosphere pointer-events-none absolute -z-10 overflow-hidden',
    config.placement === 'top'
      ? 'inset-x-0 top-0 h-[32rem] sm:h-[38rem]'
      : config.placement === 'bottom'
        ? 'inset-x-0 bottom-0 h-[24rem] sm:h-[30rem]'
        : 'inset-0',
    Astro.props.class,
  ]}
  style={inlineVars}
></div>
