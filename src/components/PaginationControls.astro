---
import { getPageTokens, getPaginatedHref } from '../utils/pagination';

interface Props {
  currentPage: number;
  totalItems: number;
  pageSize: number;
  basePath: string;
  /** Number of featured items shown at the top of Page 1 in addition to `totalItems` */
  featuredCount?: number;
  hash?: string;
  firstPageHash?: string;
  itemLabel?: string;
  ariaLabel?: string;
  class?: string;
}

const {
  currentPage,
  totalItems,
  pageSize,
  basePath,
  featuredCount = 0,
  hash = '',
  firstPageHash,
  itemLabel = 'entries',
  ariaLabel = 'Pagination',
  class: className = '',
} = Astro.props;

const resolveHref = (page: number) =>
  getPaginatedHref(basePath, page, page <= 1 ? (firstPageHash ?? hash) : hash);

const totalPages = Math.max(1, Math.ceil(totalItems / pageSize));
const displayTotal = totalItems + featuredCount;
const rangeStart =
  displayTotal === 0
    ? 0
    : currentPage === 1 && featuredCount > 0
      ? 1
      : featuredCount + (currentPage - 1) * pageSize + 1;
const rangeEnd = featuredCount + Math.min(currentPage * pageSize, totalItems);
const tokens = getPageTokens(currentPage, totalPages);
const prevHref = currentPage > 1 ? resolveHref(currentPage - 1) : null;
const nextHref = currentPage < totalPages ? resolveHref(currentPage + 1) : null;
---

{totalPages > 1 && (
  <nav
    aria-label={ariaLabel}
    class:list={[
      'pagination-nav rounded-2xl px-5 py-4 sm:px-6 bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm shadow-md ring-1 ring-gray-900/5 dark:ring-white/10 flex flex-col sm:flex-row items-center justify-between gap-4',
      className,
    ]}
  >
    <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-400">
      Showing <span class="font-semibold text-gray-900 dark:text-white">{rangeStart}</span>&ndash;<span class="font-semibold text-gray-900 dark:text-white">{rangeEnd}</span> of <span class="font-semibold text-gray-900 dark:text-white">{displayTotal}</span> {itemLabel}
    </p>

    <div class="flex items-center gap-1.5" role="group" aria-label="Page navigation">
      {prevHref ? (
        <a
          href={prevHref}
          aria-label="Previous page"
          class="inline-flex items-center gap-1 rounded-lg px-2.5 py-1.5 text-xs font-semibold text-gray-700 dark:text-gray-200 bg-gray-100/80 dark:bg-gray-700/60 ring-1 ring-inset ring-gray-200 dark:ring-gray-600/80 hover:bg-amber-50 hover:text-amber-700 hover:ring-amber-600/30 dark:hover:bg-gray-700 dark:hover:text-amber-300 transition no-underline"
        >
          <svg class="size-3.5 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M11.78 5.22a.75.75 0 0 1 0 1.06L8.06 10l3.72 3.72a.75.75 0 1 1-1.06 1.06l-4.25-4.25a.75.75 0 0 1 0-1.06l4.25-4.25a.75.75 0 0 1 1.06 0Z" clip-rule="evenodd" />
          </svg>
          <span class="hidden sm:inline">Previous</span>
        </a>
      ) : (
        <span
          aria-disabled="true"
          class="inline-flex items-center gap-1 rounded-lg px-2.5 py-1.5 text-xs font-semibold text-gray-700 dark:text-gray-200 bg-gray-100/80 dark:bg-gray-700/60 ring-1 ring-inset ring-gray-200 dark:ring-gray-600/80 opacity-40 pointer-events-none select-none"
        >
          <svg class="size-3.5 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M11.78 5.22a.75.75 0 0 1 0 1.06L8.06 10l3.72 3.72a.75.75 0 1 1-1.06 1.06l-4.25-4.25a.75.75 0 0 1 0-1.06l4.25-4.25a.75.75 0 0 1 1.06 0Z" clip-rule="evenodd" />
          </svg>
          <span class="hidden sm:inline">Previous</span>
        </span>
      )}

      <div class="flex items-center gap-1">
        {tokens.map((token) =>
          token === 'ellipsis' ? (
            <span class="px-1.5 text-xs text-gray-400 dark:text-gray-500 select-none" aria-hidden="true">…</span>
          ) : token === currentPage ? (
            <span
              aria-current="page"
              class="inline-flex min-w-8 items-center justify-center rounded-lg px-2.5 py-1.5 text-xs font-semibold bg-amber-700 text-white shadow-xs select-none"
            >
              {token}
            </span>
          ) : (
            <a
              href={resolveHref(token)}
              aria-label={`Page ${token}`}
              class="inline-flex min-w-8 items-center justify-center rounded-lg px-2.5 py-1.5 text-xs font-medium text-gray-700 dark:text-gray-300 bg-gray-100/80 dark:bg-gray-700/60 ring-1 ring-inset ring-gray-200 dark:ring-gray-600/80 hover:bg-amber-50 hover:text-amber-700 hover:ring-amber-600/30 dark:hover:bg-gray-700 dark:hover:text-amber-300 transition no-underline"
            >
              {token}
            </a>
          )
        )}
      </div>

      {nextHref ? (
        <a
          href={nextHref}
          aria-label="Next page"
          class="inline-flex items-center gap-1 rounded-lg px-2.5 py-1.5 text-xs font-semibold text-gray-700 dark:text-gray-200 bg-gray-100/80 dark:bg-gray-700/60 ring-1 ring-inset ring-gray-200 dark:ring-gray-600/80 hover:bg-amber-50 hover:text-amber-700 hover:ring-amber-600/30 dark:hover:bg-gray-700 dark:hover:text-amber-300 transition no-underline"
        >
          <span class="hidden sm:inline">Next</span>
          <svg class="size-3.5 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
          </svg>
        </a>
      ) : (
        <span
          aria-disabled="true"
          class="inline-flex items-center gap-1 rounded-lg px-2.5 py-1.5 text-xs font-semibold text-gray-700 dark:text-gray-200 bg-gray-100/80 dark:bg-gray-700/60 ring-1 ring-inset ring-gray-200 dark:ring-gray-600/80 opacity-40 pointer-events-none select-none"
        >
          <span class="hidden sm:inline">Next</span>
          <svg class="size-3.5 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
          </svg>
        </span>
      )}
    </div>
  </nav>
)}
