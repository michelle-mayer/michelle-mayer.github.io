---
interface Props {
  title?: string;
  subtitle?: string;
  subject?: string;
  compact?: boolean;
}

const {
  title = "Get in touch",
  subtitle = "Have a question, feedback, or an engineering project to discuss? Drop me a message below.",
  subject,
  compact = false,
} = Astro.props;

import { themeConfig } from '../theme.config';
const formspreeEndpoint = themeConfig.integrations.formspree.endpoint;
const contactEmail = themeConfig.author.email;
---

<div class="contact-form-container relative w-full rounded-2xl p-6 sm:p-8 shadow-lg ring-1 ring-gray-900/5 bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm dark:ring-white/10 transition-colors">
  <div class="mb-6">
    <div class="flex items-center gap-2">
      <span class="inline-flex size-2 rounded-full bg-accent-600 dark:bg-accent-500 animate-pulse"></span>
      <p class="text-xs font-semibold tracking-wider uppercase text-accent-700 dark:text-accent-500">Contact</p>
    </div>
    <h2 class="mt-1 text-2xl font-semibold tracking-tight text-gray-900 dark:text-white sm:text-3xl">
      {title}
    </h2>
    {subtitle && (
      <p class="mt-2 text-sm/6 text-gray-600 dark:text-gray-300">
        {subtitle}
      </p>
    )}
  </div>

  <!-- Form Error Alert -->
  <div class="contact-error hidden mb-6 rounded-lg bg-red-50 dark:bg-red-950/40 p-4 border border-red-200 dark:border-red-900/50 text-sm text-red-700 dark:text-red-300">
    <div class="flex items-start gap-3">
      <svg class="size-5 shrink-0 text-red-500 mt-0.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16zM8.28 7.22a.75.75 0 0 0-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 1 0 1.06 1.06L10 11.06l1.72 1.72a.75.75 0 1 0 1.06-1.06L11.06 10l1.72-1.72a.75.75 0 0 0-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
      </svg>
      <div>
        <p class="font-medium">Message could not be sent</p>
        <p class="error-message mt-0.5 text-xs text-red-600 dark:text-red-400">
          Please check your entries and try again, or email directly at <a href={`mailto:${contactEmail}`} class="underline font-semibold">{contactEmail}</a>.
        </p>
      </div>
    </div>
  </div>

  <!-- Contact Form -->
  <form
    action={formspreeEndpoint}
    method="POST"
    class="contact-form space-y-4"
    data-contact-form
    data-contact-email={contactEmail}
  >
    <!-- Spam honeypot (bots will fill this in, Formspree discards) -->
    <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
    
    <!-- Optional custom email subject -->
    {subject && (
      <input type="hidden" name="_subject" value={subject} />
    )}

    <div class={compact ? "space-y-4" : "grid grid-cols-1 gap-4 sm:grid-cols-2"}>
      <div>
        <label for="name" class="block text-sm font-medium text-gray-900 dark:text-gray-200">
          Your Name <span class="text-accent-700 dark:text-accent-500">*</span>
        </label>
        <input
          type="text"
          id="name"
          name="name"
          required
          placeholder="Your name"
          class="mt-1.5 block w-full rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900/80 px-3.5 py-2.5 text-sm text-gray-900 dark:text-white placeholder:text-gray-400 focus:border-accent-600 focus:outline-none focus:ring-2 focus:ring-accent-600/20 dark:focus:ring-accent-500/20 transition"
        />
      </div>

      <div>
        <label for="email" class="block text-sm font-medium text-gray-900 dark:text-gray-200">
          Email Address <span class="text-accent-700 dark:text-accent-500">*</span>
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          placeholder="you@example.com"
          class="mt-1.5 block w-full rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900/80 px-3.5 py-2.5 text-sm text-gray-900 dark:text-white placeholder:text-gray-400 focus:border-accent-600 focus:outline-none focus:ring-2 focus:ring-accent-600/20 dark:focus:ring-accent-500/20 transition"
        />
      </div>
    </div>

    {!subject && (
      <div>
        <label for="subject-field" class="block text-sm font-medium text-gray-900 dark:text-gray-200">
          Subject
        </label>
        <input
          type="text"
          id="subject-field"
          name="_subject"
          placeholder="What would you like to discuss?"
          class="mt-1.5 block w-full rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900/80 px-3.5 py-2.5 text-sm text-gray-900 dark:text-white placeholder:text-gray-400 focus:border-accent-600 focus:outline-none focus:ring-2 focus:ring-accent-600/20 dark:focus:ring-accent-500/20 transition"
        />
      </div>
    )}

    <div>
      <label for="message" class="block text-sm font-medium text-gray-900 dark:text-gray-200">
        Message <span class="text-accent-700 dark:text-accent-500">*</span>
      </label>
      <textarea
        id="message"
        name="message"
        rows={compact ? 3 : 5}
        required
        placeholder="Say hello, share feedback, or ask a question..."
        class="mt-1.5 block w-full rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900/80 px-3.5 py-2.5 text-sm text-gray-900 dark:text-white placeholder:text-gray-400 focus:border-accent-600 focus:outline-none focus:ring-2 focus:ring-accent-600/20 dark:focus:ring-accent-500/20 transition resize-y"
      ></textarea>
    </div>

    <div class="pt-2 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <p class="text-xs text-gray-500 dark:text-gray-400">
        Emails are delivered directly to <span class="font-medium text-gray-700 dark:text-gray-300">{contactEmail}</span>.
      </p>

      <button
        type="submit"
        class="inline-flex items-center justify-center gap-2 rounded-lg bg-accent-700 px-5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-accent-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-600 disabled:opacity-60 disabled:cursor-not-allowed transition"
      >
        <svg class="submit-spinner hidden size-4 animate-spin text-white" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
        </svg>
        <span class="submit-text">Send message</span>
        <svg class="size-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5" />
        </svg>
      </button>
    </div>
  </form>

  <!-- Success State -->
  <div class="contact-success hidden py-8 text-center">
    <div class="mx-auto flex size-12 items-center justify-center rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 ring-1 ring-inset ring-emerald-600/20">
      <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
      </svg>
    </div>
    <h3 class="mt-4 text-lg font-semibold text-gray-900 dark:text-white">Message sent!</h3>
    <p class="mt-2 text-sm/6 text-gray-600 dark:text-gray-300 max-w-md mx-auto">
      Thanks for reaching out. Your message has been delivered to my inbox and I will get back to you as soon as I can.
    </p>
    <div class="mt-6">
      <button
        type="button"
        class="contact-reset-btn inline-flex items-center text-sm font-semibold text-accent-700 hover:text-accent-600 dark:text-accent-500 dark:hover:text-accent-400 transition"
      >
        Send another message <span aria-hidden="true" class="ml-1">&rarr;</span>
      </button>
    </div>
  </div>
</div>

<script>
  function setupContactForms() {
    const forms = document.querySelectorAll<HTMLFormElement>('form[data-contact-form]');
    forms.forEach((form) => {
      if (form.dataset.bound === 'true') return;
      form.dataset.bound = 'true';

      const container = form.closest('.contact-form-container');
      if (!container) return;

      const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const submitBtnText = submitBtn?.querySelector('.submit-text');
      const submitBtnSpinner = submitBtn?.querySelector('.submit-spinner');
      const successEl = container.querySelector<HTMLElement>('.contact-success');
      const errorEl = container.querySelector<HTMLElement>('.contact-error');
      const resetBtn = container.querySelector<HTMLButtonElement>('.contact-reset-btn');

      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        if (errorEl) errorEl.classList.add('hidden');
        if (submitBtn) submitBtn.disabled = true;
        if (submitBtnText) submitBtnText.textContent = 'Sending...';
        if (submitBtnSpinner) submitBtnSpinner.classList.remove('hidden');

        try {
          const formData = new FormData(form);
          const response = await fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: {
              'Accept': 'application/json'
            }
          });

          if (response.ok) {
            form.classList.add('hidden');
            if (successEl) successEl.classList.remove('hidden');
            form.reset();
          } else {
            const data: { errors?: Array<{ message: string }> } | null = await response.json().catch(() => null);
            let errorMessage = "Oops! There was a problem submitting your form.";
            if (data && data.errors && data.errors.length > 0) {
              errorMessage = data.errors.map((err) => err.message).join(', ');
            }
            if (errorEl) {
              const errorText = errorEl.querySelector('.error-message');
              if (errorText) errorText.textContent = errorMessage;
              errorEl.classList.remove('hidden');
            }
          }
        } catch {
          if (errorEl) {
            const errorText = errorEl.querySelector('.error-message');
            if (errorText) {
              const fallbackEmail = form.dataset.contactEmail;
              errorText.textContent = fallbackEmail
                ? `Network error. Please try again or email directly at ${fallbackEmail}.`
                : 'Network error. Please try again later.';
            }
            errorEl.classList.remove('hidden');
          }
        } finally {
          if (submitBtn) submitBtn.disabled = false;
          if (submitBtnText) submitBtnText.textContent = 'Send message';
          if (submitBtnSpinner) submitBtnSpinner.classList.add('hidden');
        }
      });

      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          if (successEl) successEl.classList.add('hidden');
          form.classList.remove('hidden');
        });
      }
    });
  }

  // Run on initial load
  setupContactForms();
</script>
