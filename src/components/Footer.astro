---
import Logo from './Logo.astro';
import { themeConfig } from '../theme.config';
import { isFeatureEnabled } from '../utils/features';
const currentYear = new Date().getFullYear();
const { site, author, socials, footer } = themeConfig;
const showContact = isFeatureEnabled('contact');
const showRss = isFeatureEnabled('rss');
const linkClass =
  'group inline-flex items-center gap-2 text-sm/6 text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors';
---

<footer class="border-t border-gray-100 dark:border-gray-800 bg-white dark:bg-gray-900 transition-colors">
  <div class="mx-auto max-w-7xl px-6 py-10 sm:py-12 lg:px-8">
    <div class="flex flex-col items-center gap-6 sm:flex-row sm:justify-between">
      <a
        href="/"
        title={`${site.title} - Home`}
        aria-label={`${site.title} Homepage`}
        class="group inline-block"
      >
        <Logo class="h-12 w-auto overflow-visible transition-opacity group-hover:opacity-80" />
      </a>

      <nav aria-label="Footer">
        <ul class="flex flex-wrap items-center justify-center gap-x-6 gap-y-3">
          {showContact && (
          <li>
            <a href="/contact/" class={linkClass}>
              <svg class="size-4 text-gray-400 dark:text-gray-500 transition-colors group-hover:text-accent-600 dark:group-hover:text-accent-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
              </svg>
              <span>Contact</span>
            </a>
          </li>
          )}
          {socials.linkedin && (
          <li>
            <a href={socials.linkedin} class={linkClass}>
              <svg class="size-4 text-gray-400 dark:text-gray-500 transition-colors group-hover:text-[#0a66c2] shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76a1.69 1.69 0 0 0 1.69-1.69 1.7 1.7 0 0 0-1.69-1.7 1.7 1.7 0 0 0-1.7 1.7 1.69 1.69 0 0 0 1.7 1.69m1.4 9.74v-8.37H5.06v8.37h2.8Z"/>
              </svg>
              <span>LinkedIn</span>
            </a>
          </li>
          )}
          {socials.github && (
          <li>
            <a href={socials.github} class={linkClass}>
              <svg class="size-4 text-gray-400 dark:text-gray-500 transition-colors group-hover:text-gray-900 dark:group-hover:text-white shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z" />
              </svg>
              <span>GitHub</span>
            </a>
          </li>
          )}
          {socials.gitlab && (
          <li>
            <a href={socials.gitlab} class={linkClass}>
              <svg class="size-4 text-gray-400 dark:text-gray-500 transition-colors group-hover:text-[#fc6d26] shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M23.955 13.587l-1.342-4.135-2.664-8.189c-.135-.423-.73-.423-.867 0L16.418 9.45H7.582L4.919 1.263C4.783.84 4.185.84 4.05 1.26L1.386 9.449.044 13.587c-.121.375.014.789.331 1.023L12 23.054l11.625-8.443c.318-.235.453-.647.33-1.024Z"/>
              </svg>
              <span>GitLab</span>
            </a>
          </li>
          )}
          {socials.instagram && (
          <li>
            <a href={socials.instagram} class={linkClass}>
              <svg class="size-4 text-gray-400 dark:text-gray-500 transition-colors group-hover:text-[#E4405F] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="20" height="20" x="2" y="2" rx="5" ry="5" />
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                <line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
              </svg>
              <span>Instagram</span>
            </a>
          </li>
          )}
          {showRss && (
          <li>
            <a href="/rss.xml" class={linkClass}>
              <svg class="size-4 text-gray-400 dark:text-gray-500 transition-colors group-hover:text-accent-600 dark:group-hover:text-accent-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 11a9 9 0 0 1 9 9" />
                <path d="M4 4a16 16 0 0 1 16 16" />
                <circle cx="5" cy="19" r="1" />
              </svg>
              <span>RSS</span>
            </a>
          </li>
          )}
        </ul>
      </nav>
    </div>

    <div data-footer-bottom class="mt-8 border-t border-gray-100 dark:border-gray-800/80 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-gray-500 dark:text-gray-400">
      <p>&copy; {currentYear} <a href={site.url} class="hover:text-gray-700 dark:hover:text-gray-200 transition-colors">{author.name}</a></p>
      {footer.showThemeAttribution && (
        <p class="flex flex-wrap items-center justify-center gap-1.5 text-gray-500 dark:text-gray-400">
          <span>Based on <a href="https://github.com/edstuurman/the-navigator" class="hover:text-gray-700 dark:hover:text-gray-200 transition-colors">The Navigator</a> by <a href="https://www.stuurman.com" class="hover:text-gray-700 dark:hover:text-gray-200 transition-colors">Ed Stuurman</a>. Built with</span>
          <span class="inline-flex items-center">
            <a href="https://astro.build/" class="group inline-flex items-center gap-1 text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white transition-colors">
              <svg class="size-3.5 shrink-0 fill-gray-500 dark:fill-gray-400 group-hover:fill-gray-800 dark:group-hover:fill-gray-200 transition-colors" viewBox="0 0 85 107" fill="currentColor" aria-hidden="true">
                <path d="M0 69.6s14.3-7 28.7-7l10.8-33.5c.4-1.6 1.6-2.7 3-2.7 1.2 0 2.4 1.1 2.8 2.7l10.9 33.5c17 0 28.6 7 28.6 7L60.5 3.2c-.7-2-2-3.2-3.5-3.2H27.8c-1.6 0-2.7 1.3-3.4 3.2L0 69.6Z" />
                <path d="M27.6 91.1c-4.8-4.4-6.3-13.7-4.2-20.4 3.5 4.2 8.3 5.6 13.3 6.3 7.7 1.2 15.3.8 22.5-2.8l2.5-1.4c.7 2 .9 3.9.6 5.9-.6 4.9-3 8.7-6.9 11.5-1.5 1.2-3.2 2.2-4.8 3.3-4.9 3.3-6.2 7.2-4.4 12.9l.2.6a13 13 0 0 1-5.7-5 13.8 13.8 0 0 1-2.2-7.4c0-1.3 0-2.7-.2-4-.5-3.1-2-4.6-4.8-4.7a5.5 5.5 0 0 0-5.7 4.6l-.2.6Z" />
              </svg>
              <span>Astro</span>
            </a>,
          </span>
          <svg class="size-3.5 text-gray-500 dark:text-gray-400 fill-current shrink-0" viewBox="0 0 20 20" aria-label="love">
            <path d="m9.653 16.915-.005-.003-.019-.01a20.759 20.759 0 0 1-3.016-2.072 17.585 17.585 0 0 1-3.32-3.414C2.36 9.878 2 8.356 2 6.75 2 4.126 4.126 2 6.75 2c1.378 0 2.658.604 3.25 1.579C10.592 2.604 11.872 2 13.25 2 15.874 2 18 4.126 18 6.75c0 1.606-.36 3.128-1.308 4.665a17.585 17.585 0 0 1-3.32 3.414 20.759 20.759 0 0 1-3.016 2.072l-.019.01-.005.003h-.002a.75.75 0 0 1-.69 0h-.002Z" />
          </svg>
          <span>and</span>
          <svg class="size-3.5 text-gray-500 dark:text-gray-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-label="robots">
            <path d="M12 8V4H8" />
            <rect width="16" height="12" x="4" y="8" rx="2" />
            <path d="M2 14h2" />
            <path d="M20 14h2" />
            <path d="M15 13v2" />
            <path d="M9 13v2" />
          </svg>
        </p>
      )}
    </div>
  </div>
</footer>
