---
import { isFeatureEnabled } from '../utils/features';

interface Props {
  variant: 'now' | 'log';
  class?: string;
}

const { variant, class: className = '' } = Astro.props;
const showContact = isFeatureEnabled('contact');
const showBlog = isFeatureEnabled('blog');
const showLog = isFeatureEnabled('log');
const showNow = isFeatureEnabled('now');
const showPhotography = isFeatureEnabled('photography');
const showAbout = isFeatureEnabled('about');
const showSecondCard = variant === 'now' ? showLog : showNow;
const hasAnyPathForward = showBlog || showSecondCard || showPhotography || showAbout;
---

<div
  class:list={[
    'rounded-2xl p-6 sm:p-8 bg-amber-50/60 dark:bg-amber-950/20 border border-amber-200/60 dark:border-amber-900/40 text-sm/6 text-gray-600 dark:text-gray-300 space-y-6',
    className,
  ]}
>
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <div>
      {variant === 'now' ? (
        <>
          <p class="font-medium text-gray-900 dark:text-white">
            Inspired by the{' '}
            <a
              href="https://nownownow.com/about"
              target="_blank"
              rel="noopener noreferrer"
              class="underline font-semibold text-amber-700 dark:text-amber-400"
            >/now page movement</a>{' '}
            by Derek Sivers.
          </p>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">
            Have thoughts, questions, or just want to say hi?
          </p>
        </>
      ) : (
        <>
          <p class="font-medium text-gray-900 dark:text-white">Looking for something else?</p>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">
            Have questions, operational thoughts, or want to discuss architecture?
          </p>
        </>
      )}
    </div>
    {showContact && (
      <a
        href="/contact/"
        class="shrink-0 inline-flex items-center gap-1.5 rounded-lg bg-amber-700 px-4 py-2 text-xs font-semibold text-white shadow-xs hover:bg-amber-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600 transition"
      >
        <span>Get in touch</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    )}
  </div>

  <!-- Paths Forward -->
  {hasAnyPathForward && (
    <div class="pt-5 border-t border-amber-200/60 dark:border-amber-900/40">
      <p class="text-xs font-semibold uppercase tracking-wider text-amber-900/80 dark:text-amber-300/80 mb-3">
        Paths forward &amp; deeper dives
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
        {showBlog && (
          <a
            href="/blog/"
            class="border-beam-card group flex items-center justify-between rounded-xl p-3.5 bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm ring-1 ring-gray-900/5 dark:ring-white/10 hover:ring-cyan-500/40 hover:bg-white dark:hover:bg-gray-800 hover:shadow-md transition shadow-xs text-inherit no-underline"
          >
            <div class="flex items-center gap-2.5 min-w-0">
              <svg class="size-4 text-gray-400 dark:text-gray-500 group-hover:text-cyan-500 transition-colors shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z" />
                <path d="M6 6h10" />
                <path d="M6 10h10" />
              </svg>
              <div class="truncate">
                <span class="font-semibold text-gray-900 dark:text-white group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors block truncate">Technical Blog</span>
                <span class="text-[11px] text-gray-500 dark:text-gray-400 block truncate">Architecture &amp; engineering write-ups</span>
              </div>
            </div>
            <span class="text-gray-400 dark:text-gray-500 group-hover:text-cyan-600 dark:group-hover:text-cyan-400 group-hover:translate-x-0.5 transition-all text-sm shrink-0 ml-2" aria-hidden="true">&rarr;</span>
          </a>
        )}

        {variant === 'now' ? (
          showLog && (
            <a
              href="/log/"
              class="border-beam-card group flex items-center justify-between rounded-xl p-3.5 bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm ring-1 ring-gray-900/5 dark:ring-white/10 hover:ring-amber-500/40 hover:bg-white dark:hover:bg-gray-800 hover:shadow-md transition shadow-xs text-inherit no-underline"
            >
              <div class="flex items-center gap-2.5 min-w-0">
                <svg class="size-4 text-gray-400 dark:text-gray-500 group-hover:text-amber-600 shrink-0 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                  <polyline points="14 2 14 8 20 8" />
                  <line x1="16" y1="13" x2="8" y2="13" />
                  <line x1="16" y1="17" x2="8" y2="17" />
                  <polyline points="10 9 9 9 8 9" />
                </svg>
                <div class="truncate">
                  <span class="font-semibold text-gray-900 dark:text-white group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors block truncate">Operational Log</span>
                  <span class="text-[11px] text-gray-500 dark:text-gray-400 block truncate">Field notes, homelab &amp; releases</span>
                </div>
              </div>
              <span class="text-gray-400 dark:text-gray-500 group-hover:text-amber-600 dark:group-hover:text-amber-400 group-hover:translate-x-0.5 transition-all text-sm shrink-0 ml-2" aria-hidden="true">&rarr;</span>
            </a>
          )
        ) : (
          showNow && (
            <a
              href="/now/"
              class="border-beam-card group flex items-center justify-between rounded-xl p-3.5 bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm ring-1 ring-gray-900/5 dark:ring-white/10 hover:ring-emerald-500/40 hover:bg-white dark:hover:bg-gray-800 hover:shadow-md transition shadow-xs text-inherit no-underline"
            >
              <div class="flex items-center gap-2.5 min-w-0">
                <svg class="size-4 text-gray-400 dark:text-gray-500 group-hover:text-emerald-500 shrink-0 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="10" />
                  <polyline points="12 6 12 12 16 14" />
                </svg>
                <div class="truncate">
                  <span class="font-semibold text-gray-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors block truncate">Now &amp; Focus</span>
                  <span class="text-[11px] text-gray-500 dark:text-gray-400 block truncate">Current projects, priorities &amp; gear</span>
                </div>
              </div>
              <span class="text-gray-400 dark:text-gray-500 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 group-hover:translate-x-0.5 transition-all text-sm shrink-0 ml-2" aria-hidden="true">&rarr;</span>
            </a>
          )
        )}

        {showPhotography && (
          <a
            href="/photography/"
            class="border-beam-card group flex items-center justify-between rounded-xl p-3.5 bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm ring-1 ring-gray-900/5 dark:ring-white/10 hover:ring-fuchsia-500/40 hover:bg-white dark:hover:bg-gray-800 hover:shadow-md transition shadow-xs text-inherit no-underline"
          >
            <div class="flex items-center gap-2.5 min-w-0">
              <svg class="size-4 text-gray-400 dark:text-gray-500 group-hover:text-fuchsia-500 shrink-0 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z" />
                <circle cx="12" cy="13" r="3" />
              </svg>
              <div class="truncate">
                <span class="font-semibold text-gray-900 dark:text-white group-hover:text-fuchsia-600 dark:group-hover:text-fuchsia-400 transition-colors block truncate">Photography</span>
                <span class="text-[11px] text-gray-500 dark:text-gray-400 block truncate">Street &amp; landscape photo roll</span>
              </div>
            </div>
            <span class="text-gray-400 dark:text-gray-500 group-hover:text-fuchsia-600 dark:group-hover:text-fuchsia-400 group-hover:translate-x-0.5 transition-all text-sm shrink-0 ml-2" aria-hidden="true">&rarr;</span>
          </a>
        )}

        {showAbout && (
          <a
            href="/about/"
            class="border-beam-card group flex items-center justify-between rounded-xl p-3.5 bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm ring-1 ring-gray-900/5 dark:ring-white/10 hover:ring-indigo-500/40 hover:bg-white dark:hover:bg-gray-800 hover:shadow-md transition shadow-xs text-inherit no-underline"
          >
            <div class="flex items-center gap-2.5 min-w-0">
              <svg class="size-4 text-gray-400 dark:text-gray-500 group-hover:text-indigo-500 shrink-0 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
                <circle cx="12" cy="7" r="4" />
              </svg>
              <div class="truncate">
                <span class="font-semibold text-gray-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors block truncate">About &amp; Career</span>
                <span class="text-[11px] text-gray-500 dark:text-gray-400 block truncate">Experience, skills &amp; timeline</span>
              </div>
            </div>
            <span class="text-gray-400 dark:text-gray-500 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 group-hover:translate-x-0.5 transition-all text-sm shrink-0 ml-2" aria-hidden="true">&rarr;</span>
          </a>
        )}
      </div>
    </div>
  )}
</div>

