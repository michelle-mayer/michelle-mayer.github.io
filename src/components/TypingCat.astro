---
import typingCat from '../ascii/typingCat';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

// The resting frame ships in the HTML, so the cat shows before (or without) JavaScript.
// Playback is driven by AsciiToggle, which mounts every `[data-ascii-piece]` in its group.
const stillFrame = typingCat()(0);
const label = 'ASCII art of a cat typing hello world on a laptop';
---

<figure class:list={['typing-cat relative m-0', className]}>
  <pre
    role="img"
    aria-label={label}
    class="typing-cat-art text-gray-700 dark:text-gray-200"
    data-ascii-piece="typing-cat"
  >{stillFrame}</pre>
</figure>

<style>
  .typing-cat {
    container-type: inline-size;
  }

  /* 64 columns at ~0.6em per character: scale to fit the container, capped at 10px. */
  .typing-cat-art {
    margin: 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;
    font-size: min(10px, calc(100cqw / 39));
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: 0;
    white-space: pre;
    font-variant-ligatures: none;
    overflow: hidden;
  }
</style>

