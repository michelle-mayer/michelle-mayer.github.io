---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { getNavLinks } from '../utils/navigation';
import { themeConfig } from '../theme.config';

const navLinks = getNavLinks(Astro.url.pathname);
---

<header class="relative z-30 bg-white dark:bg-gray-900 border-b border-gray-200/75 dark:border-gray-800 shadow-2xs dark:shadow-none transition-colors">
  <nav aria-label="Main navigation" class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-8">
      <a
        href="/"
        title={`${themeConfig.site.title} - Home`}
        aria-label={`${themeConfig.site.title} Homepage`}
        class="group relative z-10 flex h-16 shrink-0 items-center overflow-visible"
      >
        <Logo class="h-16 w-auto overflow-visible transition-opacity group-hover:opacity-80" />
      </a>

      <ul class="hidden lg:flex lg:h-16 lg:items-stretch lg:gap-7">
        {navLinks.map((item) => (
          <li class="flex items-stretch">
            <a
              href={item.href}
              aria-current={item.active ? 'page' : undefined}
              class:list={[
                'inline-flex items-center border-b-2 px-1 pt-0.5 text-sm font-medium transition-colors',
                item.active
                  ? 'border-amber-600 text-gray-900 dark:text-white'
                  : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-800 dark:text-gray-400 dark:hover:border-gray-600 dark:hover:text-gray-200',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="flex items-center gap-2">
      <ThemeToggle id="theme-toggle" />

      <button
        id="nav-drawer-toggle"
        type="button"
        aria-controls="nav-mobile-drawer"
        aria-expanded="false"
        aria-label="Toggle navigation menu"
        class="nav-drawer-btn inline-flex lg:hidden items-center justify-center rounded-lg p-2 text-gray-500 hover:bg-gray-100 hover:text-gray-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-200 transition-colors cursor-pointer"
      >
        <svg class="nav-icon-bars size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
          <line x1="4" y1="6.75" x2="20" y2="6.75" />
          <line x1="4" y1="12" x2="20" y2="12" />
          <line x1="4" y1="17.25" x2="20" y2="17.25" />
        </svg>
        <svg class="nav-icon-close hidden size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
          <line x1="6" y1="6" x2="18" y2="18" />
          <line x1="18" y1="6" x2="6" y2="18" />
        </svg>
      </button>
    </div>
  </nav>

  <div
    id="nav-mobile-drawer"
    hidden
    class="hidden lg:hidden border-t border-gray-200/80 dark:border-gray-800 bg-white dark:bg-gray-900"
  >
    <ul class="space-y-1 py-2.5">
      {navLinks.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={item.active ? 'page' : undefined}
            class:list={[
              'block border-l-4 py-2 pr-4 pl-3.5 text-base font-medium transition-colors',
              item.active
                ? 'border-amber-600 bg-amber-50/80 text-amber-700 dark:bg-gray-800 dark:text-amber-500'
                : 'border-transparent text-gray-600 hover:border-gray-300 hover:bg-gray-50 hover:text-gray-900 dark:text-gray-400 dark:hover:border-gray-600 dark:hover:bg-gray-800/70 dark:hover:text-gray-200',
            ]}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  let drawerEscapeAttached = false;

  function setupNavDrawer() {
    const toggle = document.getElementById('nav-drawer-toggle');
    const drawer = document.getElementById('nav-mobile-drawer');
    if (!toggle || !drawer || toggle.dataset.bound === 'true') return;
    toggle.dataset.bound = 'true';

    const barsIcon = toggle.querySelector('.nav-icon-bars');
    const closeIcon = toggle.querySelector('.nav-icon-close');

    const updateOpenState = (open: boolean) => {
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      drawer.hidden = !open;
      drawer.classList.toggle('hidden', !open);
      barsIcon?.classList.toggle('hidden', open);
      closeIcon?.classList.toggle('hidden', !open);
    };

    toggle.addEventListener('click', () => {
      const currentlyOpen = toggle.getAttribute('aria-expanded') === 'true';
      updateOpenState(!currentlyOpen);
    });

    drawer.querySelectorAll('a').forEach((anchor) => {
      anchor.addEventListener('click', () => updateOpenState(false));
    });

    if (!drawerEscapeAttached) {
      drawerEscapeAttached = true;
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        const activeToggle = document.getElementById('nav-drawer-toggle');
        const activeDrawer = document.getElementById('nav-mobile-drawer');
        if (activeToggle && activeDrawer && activeToggle.getAttribute('aria-expanded') === 'true') {
          activeToggle.setAttribute('aria-expanded', 'false');
          activeDrawer.hidden = true;
          activeDrawer.classList.add('hidden');
          activeToggle.querySelector('.nav-icon-bars')?.classList.remove('hidden');
          activeToggle.querySelector('.nav-icon-close')?.classList.add('hidden');
          activeToggle.focus();
        }
      });
    }
  }

  setupNavDrawer();
</script>
