---
interface Props {
  class?: string;
  id?: string;
  variant?: 'default' | 'pill';
  iconClass?: string;
}

const {
  class: className = '',
  id = 'theme-toggle',
  variant = 'default',
  iconClass,
} = Astro.props;

const isPill = variant === 'pill';
const baseClass = isPill
  ? 'inline-flex items-center justify-center size-6 sm:size-7 rounded-full text-gray-400 hover:text-amber-600 dark:hover:text-amber-400 hover:bg-gray-100 dark:hover:bg-gray-800 focus:outline-hidden focus:ring-2 focus:ring-amber-600 transition-colors cursor-pointer'
  : 'relative inline-flex items-center justify-center rounded-lg p-2 text-gray-500 hover:bg-gray-100 hover:text-gray-900 focus:outline-hidden focus:ring-2 focus:ring-amber-600 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white transition-colors cursor-pointer';

const effectiveIconClass = iconClass ?? (isPill ? 'size-3 sm:size-3.5' : 'size-5');
---

<button
  type="button"
  id={id}
  data-theme-toggle
  aria-label="Toggle theme"
  title="Toggle light / dark mode"
  class:list={[baseClass, className]}
>
  <!-- Sun Icon (shown in dark mode) -->
  <svg
    class:list={[effectiveIconClass, 'hidden dark:block text-amber-400']}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2"></path>
    <path d="M12 20v2"></path>
    <path d="m4.93 4.93 1.41 1.41"></path>
    <path d="m17.66 17.66 1.41 1.41"></path>
    <path d="M2 12h2"></path>
    <path d="M20 12h2"></path>
    <path d="m6.34 17.66-1.41 1.41"></path>
    <path d="m19.07 4.93-1.41 1.41"></path>
  </svg>

  <!-- Moon Icon (shown in light mode) -->
  <svg
    class:list={[effectiveIconClass, 'block dark:hidden', isPill ? 'text-gray-400 hover:text-amber-600' : 'text-gray-600']}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
</button>

<script>
  function setupThemeToggle() {
    document.querySelectorAll<HTMLElement>('[data-theme-toggle]').forEach((toggle) => {
      // Avoid duplicate listener attachments
      if (toggle.dataset.themeBound === 'true') return;
      toggle.dataset.themeBound = 'true';

      toggle.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        document.documentElement.classList.toggle('light', !isDark);
        try {
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        } catch (_) {}
      });
    });
  }

  setupThemeToggle();
</script>

